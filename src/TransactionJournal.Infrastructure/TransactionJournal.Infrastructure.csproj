<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TransactionJournal.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.12" />
    <PackageReference Include="Polly.Core" Version="8.8.0" />
  </ItemGroup>

  <!-- В монолите internal-типы Bybit были доступны всей сборке: сохраняем видимость
       для Web (парсинг JSON материала) и зеркальных тестов клиента Bybit. -->
  <ItemGroup>
    <InternalsVisibleTo Include="TransactionJournal" />
    <InternalsVisibleTo Include="TransactionJournal.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransactionJournal.Application\TransactionJournal.Application.csproj" />
    <ProjectReference Include="..\TransactionJournal.Domain\TransactionJournal.Domain.csproj" />
    <!-- Адаптеры портов окружения подсказок: направление «адаптер → порт»,
         как у доменных store-портов (ADR-0007/ADR-0008).
         Traceability: openspec:architecture/solution-structure#requirement-dependencies-point-inward -->
    <ProjectReference Include="..\TransactionJournal.Hints\TransactionJournal.Hints.csproj" />
    <!-- Адаптер детерминированного снимка контекста консультации: направление
         «адаптер → порт», как у остальных портов окружения.
         Traceability: openspec:architecture/solution-structure#requirement-dependencies-point-inward -->
    <ProjectReference Include="..\TransactionJournal.Consultations\TransactionJournal.Consultations.csproj" />
  </ItemGroup>

</Project>
