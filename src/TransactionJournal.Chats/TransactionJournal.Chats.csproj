<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TransactionJournal.Chats</RootNamespace>
  </PropertyGroup>

  <!-- Окружение чата агента: зависит только от домена (ADR-0009).
       Ссылки на Application, Infrastructure, Web и Hints запрещены: доступ к
       корпусу правил идёт через собственный порт с адаптером в composition root,
       доступ к рынку — через порт рыночных данных с адаптером в Infrastructure.
       Traceability: openspec:architecture/solution-structure#requirement-dependencies-point-inward -->
  <ItemGroup>
    <ProjectReference Include="..\TransactionJournal.Domain\TransactionJournal.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Реестр read-only инструментов и агентный цикл строятся на абстракциях
         Microsoft.Extensions.AI (ADR-0009); стабильная линия 10.x согласована
         с адаптером OpenAI-совместимых провайдеров в composition root. -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
  </ItemGroup>

</Project>
