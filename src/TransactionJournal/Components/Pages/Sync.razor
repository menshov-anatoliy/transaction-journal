@page "/sync"
@using System.Globalization
@using TransactionJournal.Data
@using TransactionJournal.Domain.Data
@using TransactionJournal.Sync
@rendermode InteractiveServer
@inject IJournalSyncService SyncService
@inject IExecutionSyncStateStore StateStore
@inject ISyncJournalReadModel SyncJournal

<PageTitle>Синхронизация Bybit</PageTitle>

<h1>Синхронизация Bybit</h1>

<p>Ручная загрузка истории исполнения и экспираций из Bybit в журнал: первый запуск догружает всю доступную историю, повторные — только новые записи.</p>

@if (_running)
{
	<p role="status">Синхронизация выполняется…</p>
}
else
{
	<button type="button" @onclick="RunSyncAsync">Синхронизировать</button>
}

@if (_error is not null)
{
	<div role="alert">
		<strong>Синхронизация прервана:</strong> @_error
	</div>
}

@if (ResultView is { } view)
{
	<section>
		<h2>Результат</h2>

		@if (view.Status == SyncRunStatus.Succeeded)
		{
			@* Статус и режим одного запуска: счётчики новых записей приходят из строки SyncRun. *@
			<p>Синхронизация завершена. Режим: @ModeLabel(view.Mode).</p>
			<ul>
				<li>Новых записей исполнения: @view.NewExecutions</li>
				<li>Новых delivery-записей: @view.NewDeliveries</li>
				<li>Новых инструментов в справочнике: @view.NewInstruments</li>
			</ul>
		}
		else
		{
			@* Прерванный запуск из журнала: предупреждения у него не сохраняются,
				но причина прерывания остаётся видна при загрузке страницы. *@
			<p>Последний запуск синхронизации прерван: @view.Error</p>
		}

		@if (view.SkippedAreas is { Count: > 0 } skippedAreas)
		{
			@* Заметка стоит рядом с результатом запуска: пропуск области не помечает
				запуск ошибкой, но данные области не загружены — перечень не должен
				остаться незамеченным, в том числе при нулевых счётчиках записей. *@
			<p role="note">
				Пропущенные области (биржа отказала в истории: контракт недоступен для торговли):
				@string.Join(", ", skippedAreas)
			</p>
		}

		@if (view.UnresolvedInstruments is { Count: > 0 } unresolvedInstruments)
		{
			@* Инструменты без спецификации не роняют запуск и проекцию: их записи
				отложены до появления спецификации, поэтому перечень отложенных символов
				должен быть виден рядом с результатом запуска — иначе пропажа сделок
				останется незамеченной. *@
			<p role="note">
				Неразрешённые инструменты (спецификация не получена: контракт недоступен для торговли;
				сделки по ним отложены): @string.Join(", ", unresolvedInstruments)
			</p>
		}

		@if (view.UncoveredBaseCoins is { Count: > 0 } uncoveredBaseCoins)
		{
			@* Дыра покрытия доски не помечает запуск ошибкой, но история актива не
				обходилась: заметка называет оба средства лечения — конфигурацию
				дополнительных активов доски и сброс состояния категории. *@
			<p role="note">
				Непокрытые базовые активы опционной доски (история не обходилась запуском:
				добавьте активы в конфигурацию дополнительных активов доски Sync:ExtraOptionBaseCoins
				и сбросьте состояние категории option для повторного полного перебора):
				@string.Join(", ", uncoveredBaseCoins)
			</p>
		}
	</section>

	@if (_result is not null)
	{
		@if (_result.ProjectionError is not null)
		{
			<div role="alert">
				<strong>Проекция журнала не построена:</strong> @_result.ProjectionError
			</div>
		}
		else if (_result.Projection is { } projection)
		{
			@if (projection.ReconciliationWarnings.Count == 0)
			{
				<p>Расхождений сверки экспираций с биржей нет.</p>
			}
			else
			{
				@* Предупреждение сверки не блокирует синк: собственный расчёт остаётся источником результата. *@
				@* Время доставки хранится в UTC и показывается локальным временем. *@
				@* Traceability: openspec:ui/screens#scenario-sync-dates-shown-local *@
				<h2>Предупреждения сверки с биржей</h2>
				<ul>
					@foreach (var warning in projection.ReconciliationWarnings)
					{
						<li>
							@warning.Symbol
							(@DisplayTime.FormatMoment(warning.DeliveryTime)):
							расхождение @warning.Difference.ToString("0.0###", CultureInfo.InvariantCulture)
						</li>
					}
				</ul>
			}
		}
	}
}

@* Обслуживание состояния синхронизации: сброс возвращает категории первичный backfill,
	требует подтверждения и заблокирован, пока выполняется синк — гонка сброса с проходом
	исключена на уровне экрана. *@
<section>
	<h2>Обслуживание</h2>
	<p>Сброс состояния категории удаляет её водяные знаки: следующий запуск синхронизации выполнит первичный backfill этой категории. Сырые записи журнала при этом не удаляются.</p>

	@if (_resetCandidateCategory is null)
	{
		<p>
			<button type="button" disabled="@_running" @onclick='() => RequestReset("linear")'>Сбросить состояние linear</button>
			<button type="button" disabled="@_running" @onclick='() => RequestReset("option")'>Сбросить состояние option</button>
		</p>
	}
	else
	{
		<div role="alertdialog" aria-label="Подтверждение сброса состояния">
			<p>Сбросить состояние синхронизации категории @_resetCandidateCategory? Следующий запуск выполнит первичный backfill этой категории.</p>
			<button type="button" @onclick="ConfirmResetAsync">Подтвердить сброс</button>
			<button type="button" @onclick="CancelReset">Отмена</button>
		</div>
	}

	@if (_resetMessage is not null)
	{
		<p role="status">@_resetMessage</p>
	}

	@if (_resetError is not null)
	{
		<div role="alert">
			<strong>Сброс состояния не выполнен:</strong> @_resetError
		</div>
	}
</section>

@code {
	private bool _running;
	private JournalSyncResult? _result;
	private SyncRunRow? _lastRun;
	private string? _error;
	private string? _resetCandidateCategory;
	private string? _resetMessage;
	private string? _resetError;

	// Блок результата: сразу после нажатия кнопки строится из свежего итога, при
	// загрузке страницы — из последней завершённой строки журнала запусков с её
	// предупреждениями; свежий итог имеет приоритет.
	// Traceability: openspec:sync/bybit-history#requirement-run-warnings-persisted
	private RunResultView? ResultView => _result is not null
		? RunResultView.FromFresh(_result)
		: _lastRun is not null
			? RunResultView.FromPersisted(_lastRun)
			: null;

	// Предупреждения последнего завершённого запуска читаются при загрузке страницы:
	// блок результата виден без повторного запуска синхронизации. Сбой чтения журнала
	// не блокирует страницу — блок появится после первого запуска синхронизации.
	// Traceability: openspec:sync/bybit-history#scenario-run-warnings-shown-on-page-load
	protected override async Task OnInitializedAsync()
	{
		try
		{
			_lastRun = await SyncJournal.ReadLastCompletedAsync();
		}
		catch (Exception)
		{
			_lastRun = null;
		}
	}

	// Единый вид блока результата для свежего итога и строки журнала запусков:
	// статус, режим, счётчики новых записей и три перечня предупреждений запуска.
	private sealed record RunResultView
	{
		public required SyncRunMode Mode { get; init; }

		public required SyncRunStatus Status { get; init; }

		public string? Error { get; init; }

		public required int NewExecutions { get; init; }

		public required int NewDeliveries { get; init; }

		public required int NewInstruments { get; init; }

		public required IReadOnlyList<string> SkippedAreas { get; init; }

		public required IReadOnlyList<string> UnresolvedInstruments { get; init; }

		public required IReadOnlyList<string> UncoveredBaseCoins { get; init; }

		public static RunResultView FromFresh(JournalSyncResult result) => new()
		{
			Mode = result.Mode,
			Status = result.Run.Status,
			Error = result.Run.Error,
			NewExecutions = result.Run.NewExecutions,
			NewDeliveries = result.Run.NewDeliveries,
			NewInstruments = result.Run.NewInstruments,
			SkippedAreas = SkippedAreasOf(result),
			UnresolvedInstruments = UnresolvedInstrumentsOf(result),
			UncoveredBaseCoins = result.UncoveredBaseCoins,
		};

		// Предупреждения последнего запуска разбираются из сохранённого JSON строки:
		// запуски без сохранённого значения читаются пустыми перечнями — заметок нет.
		// Traceability: openspec:sync/bybit-history#scenario-run-warnings-shown-on-page-load
		public static RunResultView FromPersisted(SyncRunRow row)
		{
			var warnings = row.Warnings;
			return new RunResultView
			{
				Mode = row.Mode,
				Status = row.Status,
				Error = row.Error,
				NewExecutions = row.NewExecutions,
				NewDeliveries = row.NewDeliveries,
				NewInstruments = row.NewInstruments,
				SkippedAreas = warnings.SkippedAreas,
				UnresolvedInstruments = warnings.UnresolvedInstruments,
				UncoveredBaseCoins = warnings.UncoveredBaseCoins,
			};
		}
	}

	// Единственная ручная команда синхронизации: запуск выполняется до конца, кнопка
	// блокируется на время работы, результат и ошибка показываются на этой же странице.
	private async Task RunSyncAsync()
	{
		_running = true;
		_result = null;
		_error = null;

		try
		{
			_result = await SyncService.SyncAsync();
		}
		catch (Exception ex)
		{
			_error = ex.Message;
		}
		finally
		{
			_running = false;
		}
	}

	private static string ModeLabel(SyncRunMode mode) => mode == SyncRunMode.Backfill
		? "первичная загрузка (backfill)"
		: "инкрементальная догрузка";

	// Перечень пропущенных областей сводится из результатов обоих движков: метки
	// формируют движки категорий, страница только показывает их пользователю —
	// сначала области исполнения, затем delivery, в стабильном порядке по категориям.
	// Traceability: openspec:sync/bybit-history#scenario-skipped-areas-reported-to-user
	private static IReadOnlyList<string> SkippedAreasOf(JournalSyncResult result)
	{
		var executionAreas = result.Executions
			.OrderBy(pair => pair.Key, StringComparer.Ordinal)
			.SelectMany(pair => pair.Value.SkippedAreas);
		var deliveryAreas = result.Deliveries
			.OrderBy(pair => pair.Key, StringComparer.Ordinal)
			.SelectMany(pair => pair.Value.SkippedAreas);
		return executionAreas.Concat(deliveryAreas).ToList();
	}

	// Перечень неразрешённых инструментов сводится из итога пополнения справочника
	// и перестроенной проекции: спецификация могла быть не получена и в этом запуске,
	// и в прежних — пользователь видит все отложенные символы единым списком.
	// Traceability: openspec:sync/bybit-history#scenario-unresolved-symbols-reported-to-user
	private static IReadOnlyList<string> UnresolvedInstrumentsOf(JournalSyncResult result)
	{
		var projectionSymbols = result.Projection?.UnresolvedInstruments ?? [];
		return result.UnresolvedInstruments
			.Concat(projectionSymbols)
			.Distinct(StringComparer.Ordinal)
			.OrderBy(symbol => symbol, StringComparer.Ordinal)
			.ToList();
	}

	// Команда сброса требует подтверждения: выбор категории лишь показывает запрос
	// подтверждения, фактический сброс состояния выполняет только явное подтверждение.
	// Traceability: openspec:sync/bybit-history#requirement-manual-category-state-reset
	private void RequestReset(string category)
	{
		_resetCandidateCategory = category;
		_resetMessage = null;
		_resetError = null;
	}

	// Отмена возвращает блок обслуживания к выбору категории без вызова хранилища.
	private void CancelReset()
	{
		_resetCandidateCategory = null;
	}

	private async Task ConfirmResetAsync()
	{
		if (_resetCandidateCategory is null)
		{
			return;
		}

		var category = _resetCandidateCategory;
		_resetCandidateCategory = null;
		try
		{
			// Сброс удаляет только водяные знаки категории: сырые записи и доменные
			// сущности журнала остаются, следующий запуск выполнит первичный backfill.
			// Traceability: openspec:sync/bybit-history#scenario-reset-keeps-journal-data
			await StateStore.ResetAsync(category);
			_resetMessage = $"Состояние категории {category} сброшено: следующий запуск синхронизации выполнит первичный backfill этой категории.";
		}
		catch (Exception ex)
		{
			_resetError = ex.Message;
		}
	}
}
