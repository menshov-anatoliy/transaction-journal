@page "/sync"
@using System.Globalization
@using TransactionJournal.Data
@using TransactionJournal.Sync
@rendermode InteractiveServer
@inject IJournalSyncService SyncService
@inject IExecutionSyncStateStore StateStore

<PageTitle>Синхронизация Bybit</PageTitle>

<h1>Синхронизация Bybit</h1>

<p>Ручная загрузка истории исполнения и экспираций из Bybit в журнал: первый запуск догружает всю доступную историю, повторные — только новые записи.</p>

@if (_running)
{
	<p role="status">Синхронизация выполняется…</p>
}
else
{
	<button type="button" @onclick="RunSyncAsync">Синхронизировать</button>
}

@if (_error is not null)
{
	<div role="alert">
		<strong>Синхронизация прервана:</strong> @_error
	</div>
}

@if (_result is not null)
{
	<section>
		<h2>Результат</h2>

		@* Статус и режим одного запуска: счётчики новых записей приходят из строки SyncRun. *@
		<p>Синхронизация завершена. Режим: @ModeLabel(_result.Mode).</p>
		<ul>
			<li>Новых записей исполнения: @_result.Run.NewExecutions</li>
			<li>Новых delivery-записей: @_result.Run.NewDeliveries</li>
			<li>Новых инструментов в справочнике: @_result.Run.NewInstruments</li>
		</ul>
	</section>

	@if (_result.ProjectionError is not null)
	{
		<div role="alert">
			<strong>Проекция журнала не построена:</strong> @_result.ProjectionError
		</div>
	}
	else if (_result.Projection is { } projection)
	{
		@if (projection.ReconciliationWarnings.Count == 0)
		{
			<p>Расхождений сверки экспираций с биржей нет.</p>
		}
		else
		{
			@* Предупреждение сверки не блокирует синк: собственный расчёт остаётся источником результата. *@
			<h2>Предупреждения сверки с биржей</h2>
			<ul>
				@foreach (var warning in projection.ReconciliationWarnings)
				{
					<li>
						@warning.Symbol
						(@warning.DeliveryTime.ToString("u", CultureInfo.InvariantCulture)):
						расхождение @warning.Difference.ToString("0.0###", CultureInfo.InvariantCulture)
					</li>
				}
			</ul>
		}
	}
}

@* Обслуживание состояния синхронизации: сброс возвращает категории первичный backfill,
	требует подтверждения и заблокирован, пока выполняется синк — гонка сброса с проходом
	исключена на уровне экрана. *@
<section>
	<h2>Обслуживание</h2>
	<p>Сброс состояния категории удаляет её водяные знаки: следующий запуск синхронизации выполнит первичный backfill этой категории. Сырые записи журнала при этом не удаляются.</p>

	@if (_resetCandidateCategory is null)
	{
		<p>
			<button type="button" disabled="@_running" @onclick='() => RequestReset("linear")'>Сбросить состояние linear</button>
			<button type="button" disabled="@_running" @onclick='() => RequestReset("option")'>Сбросить состояние option</button>
		</p>
	}
	else
	{
		<div role="alertdialog" aria-label="Подтверждение сброса состояния">
			<p>Сбросить состояние синхронизации категории @_resetCandidateCategory? Следующий запуск выполнит первичный backfill этой категории.</p>
			<button type="button" @onclick="ConfirmResetAsync">Подтвердить сброс</button>
			<button type="button" @onclick="CancelReset">Отмена</button>
		</div>
	}

	@if (_resetMessage is not null)
	{
		<p role="status">@_resetMessage</p>
	}

	@if (_resetError is not null)
	{
		<div role="alert">
			<strong>Сброс состояния не выполнен:</strong> @_resetError
		</div>
	}
</section>

@code {
	private bool _running;
	private JournalSyncResult? _result;
	private string? _error;
	private string? _resetCandidateCategory;
	private string? _resetMessage;
	private string? _resetError;

	// Единственная ручная команда синхронизации: запуск выполняется до конца, кнопка
	// блокируется на время работы, результат и ошибка показываются на этой же странице.
	private async Task RunSyncAsync()
	{
		_running = true;
		_result = null;
		_error = null;

		try
		{
			_result = await SyncService.SyncAsync();
		}
		catch (Exception ex)
		{
			_error = ex.Message;
		}
		finally
		{
			_running = false;
		}
	}

	private static string ModeLabel(SyncRunMode mode) => mode == SyncRunMode.Backfill
		? "первичная загрузка (backfill)"
		: "инкрементальная догрузка";

	// Команда сброса требует подтверждения: выбор категории лишь показывает запрос
	// подтверждения, фактический сброс состояния выполняет только явное подтверждение.
	// Traceability: openspec:sync/bybit-history#requirement-manual-category-state-reset
	private void RequestReset(string category)
	{
		_resetCandidateCategory = category;
		_resetMessage = null;
		_resetError = null;
	}

	// Отмена возвращает блок обслуживания к выбору категории без вызова хранилища.
	private void CancelReset()
	{
		_resetCandidateCategory = null;
	}

	private async Task ConfirmResetAsync()
	{
		if (_resetCandidateCategory is null)
		{
			return;
		}

		var category = _resetCandidateCategory;
		_resetCandidateCategory = null;
		try
		{
			// Сброс удаляет только водяные знаки категории: сырые записи и доменные
			// сущности журнала остаются, следующий запуск выполнит первичный backfill.
			// Traceability: openspec:sync/bybit-history#scenario-reset-keeps-journal-data
			await StateStore.ResetAsync(category);
			_resetMessage = $"Состояние категории {category} сброшено: следующий запуск синхронизации выполнит первичный backfill этой категории.";
		}
		catch (Exception ex)
		{
			_resetError = ex.Message;
		}
	}
}
