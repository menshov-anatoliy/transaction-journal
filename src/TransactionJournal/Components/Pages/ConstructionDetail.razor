	/// <summary>
	/// Открывает форму переноса сделки: читает активные конструкции, исключает
	/// текущую и подставляет первую кандидатуру целевым выбором по умолчанию.
	/// </summary>
	// Перенос предлагает выбор целевой конструкции: архивные скрыты из активного
	// списка, текущая исключена — сделка переносится только в другую конструкцию.
	// Traceability: openspec:ui/screens#scenario-detail-move-trade-choose-target
	private async Task BeginMoveTradeAsync(string execId)
	{
		if (_busy)
		{
			return;
		}

		try
		{
			var active = await Constructions.ListActiveAsync();
			_moveTargets = active
				.Where(construction => construction.Id != ConstructionId)
				.ToList();
			_moveTargetId = _moveTargets.Count > 0 ? _moveTargets[0].Id : null;
			_moveTradeExecId = execId;
			_actionError = null;
		}
		catch (Exception ex)
		{
			// Список кандидатов недоступен — форма не открывается, причина видна
			// пользователю вместо пустого выбора.
			_actionError = $"Список конструкций недоступен: {ex.Message}";
		}
	}

	/// <summary>Закрывает форму переноса без изменения принадлежности сделки.</summary>
	private void CancelMoveTrade()
	{
		_moveTradeExecId = null;
		_moveTargets = [];
		_moveTargetId = null;
		_actionError = null;
	}

