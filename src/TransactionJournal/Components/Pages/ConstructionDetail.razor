@page "/constructions/{ConstructionId:long}"
@rendermode InteractiveServer

@using System.Globalization
@using TransactionJournal.Components.Layout
@using TransactionJournal.Components.Pages
@using TransactionJournal.Data
@using TransactionJournal.Domain
@inject IConstructionDetailReadModel Detail
@inject IConstructionService Constructions
@inject ICommentService Comments
@inject ITradeBindingService Bindings
@inject IManualCloseMarkService Marks
@inject IPnLAdjustmentService Adjustments
@inject IInstrumentMarkSource MarkSource
@inject JournalChangeSignal Changes
@inject NavigationManager Navigation

<PageTitle>@(_data?.Name ?? "Конструкция") — Журнал Bybit</PageTitle>

@if (_unavailable)
{
	<h1>Конструкция</h1>
	@* Явное состояние вместо пустого экрана: журнал не прочитан — сводка и таблицы
	   не показываются, пользователь видит причину обновить экран. *@
	<p class="note">Журнал недоступен: не удалось прочитать данные конструкции. Обновите экран.</p>
}
else if (_notFound)
{
	<h1>Конструкция не найдена</h1>
	<p class="note">Конструкция @ConstructionId не найдена — возможно, она удалена. Вернитесь к списку конструкций.</p>
}
else if (_data is null)
{
	<h1>Конструкция</h1>
	<p class="note">Чтение журнала…</p>
}
else
{
	@* Транзитный экран деталей конструкции: адрес /constructions/{id} открывает
	   именованную вкладку каркаса; заголовок повторяет имя и ручной статус. *@
	<h1>@_data.Name <span class="@StatusClass(_data.Status)">@StatusText(_data.Status)</span></h1>

	@* Действия над конструкцией: свободное переименование, смена ручного
	   статуса между «открыта» и «закрыта», архивация с возвратом, изменение
	   выделенного капитала и удаление пустой с подтверждением. Мутации идут
	   сервисами домена, экран перечитывает снимок целиком после каждой. *@
	@* Traceability: openspec:ui/screens#requirement-construction-actions *@
	<div class="toolbar detail-actions">
		<button type="button" class="btn" disabled="@_busy" @onclick="BeginRename">Переименовать</button>
		@if (_data.Status == ConstructionStatus.Open)
		{
			@* Смена ручного статуса — свободный переход между «открыта» и «закрыта». *@
			<button type="button" class="btn" disabled="@_busy" @onclick="() => ChangeStatusAsync(ConstructionStatus.Closed)">Закрыть</button>
		}
		else if (_data.Status == ConstructionStatus.Closed)
		{
			<button type="button" class="btn" disabled="@_busy" @onclick="() => ChangeStatusAsync(ConstructionStatus.Open)">Открыть</button>
		}
		@if (_data.Status == ConstructionStatus.Archived)
		{
			@* Возврат из архива восстанавливает ручной статус «закрыта»: статус
			   до архивации журнал не хранит, а незаметное возвращение «открыта»
			   сделало бы конструкцию операционно активной без решения пользователя;
			   следующее «Открыть» переводит статус свободно. *@
			<button type="button" class="btn" disabled="@_busy" @onclick="() => ChangeStatusAsync(ConstructionStatus.Closed)">Вернуть из архива</button>
		}
		else
		{
			<button type="button" class="btn" disabled="@_busy" @onclick="() => ChangeStatusAsync(ConstructionStatus.Archived)">В архив</button>
		}
		<button type="button" class="btn" disabled="@_busy" @onclick="BeginCapitalChange">Изменить капитал</button>
		@if (CanDelete)
		{
			@* Удаление предлагается только конструкции без сделок и корректировок:
			   кнопки у непустой нет, пользователь снимает записи прежде удаления. *@
			<button type="button" class="btn danger" disabled="@_busy" @onclick="BeginDelete">Удалить…</button>
		}
	</div>

	@if (_actionError is not null)
	{
		@* Отказ действия доходит причиной: пользователь видит, что именно
		   блокирует изменение, экран и данные остаются без изменений. *@
		<p class="note note-error" role="alert">@_actionError</p>
	}

	@if (_action == DetailAction.Rename)
	{
		@* Форма переименования: свободная правка имени, остальные данные
		   конструкции не затрагиваются. *@
		<div class="action-form">
			<label class="action-label">
				новое имя
				<input class="action-input" maxlength="200" @bind="_renameValue" />
			</label>
			<button type="button" class="btn primary" disabled="@_busy" @onclick="RenameAsync">Сохранить имя</button>
			<button type="button" class="btn" disabled="@_busy" @onclick="CancelAction">Отмена</button>
		</div>
	}
	else if (_action == DetailAction.Capital)
	{
		@* Форма капитала: значение в USDT; правка капитала меняет только
		   процентные величины, абсолютный результат не затрагивается. *@
		<div class="action-form">
			<label class="action-label">
				выделенный капитал, USDT
				<input class="action-input" @bind="_capitalInput" />
			</label>
			<button type="button" class="btn primary" disabled="@_busy" @onclick="ChangeCapitalAsync">Сохранить капитал</button>
			<button type="button" class="btn" disabled="@_busy" @onclick="CancelAction">Отмена</button>
			@if (_capitalInvalid)
			{
				<span class="validation-message">Введите число в USDT, например 3000</span>
			}
		</div>
	}
	else if (_action == DetailAction.Delete)
	{
		@* Удаление требует явного подтверждения: подтверждение — отдельный шаг,
		   без него команда удаления не запускается. *@
		<div class="action-form">
			<span class="action-warning">Удалить пустую конструкцию «@_data.Name»? Действие необратимо.</span>
			<button type="button" class="btn danger" disabled="@_busy" @onclick="DeleteAsync">Удалить</button>
			<button type="button" class="btn" disabled="@_busy" @onclick="CancelAction">Отмена</button>
		</div>
	}

	@* Сводка метрик конструкции: итог, процент от капитала, разбивка по
	   реализованному и нереализованному результату, сумма корректировок,
	   период с длительностью и отметка времени марок оценки. *@
	@* Traceability: openspec:ui/screens#requirement-construction-detail-screen *@
	<div class="kstrip">
		<div>итог
			@if (_data.Metrics.TotalPnL is null)
			{
				@* Итог без нереализованной части неполный — признак сбоя марок,
				   а не прочерк «нулевого» итога. *@
				@* Traceability: change:add-ui-screens/design#d4 *@
				<b class="markfail" title="Итог неполный: нереализованная часть не оценена из-за сбоя марок">неполный (сбой марок)</b>
			}
			else
			{
				<b class="@SignClass(_data.Metrics.TotalPnL)">@FormatPnL(_data.Metrics.TotalPnL.Value) USDT</b>
			}
		</div>
		<div>% капитала (@FormatAmount(_data.AllocatedCapitalUsdt))<b class="@SignClass(_data.Metrics.TotalPnLPercent)">@FormatPercent(_data.Metrics.TotalPnLPercent)</b></div>
		<div>реализованный<b class="@SignClass(_data.Metrics.RealizedPnL)">@FormatPnL(_data.Metrics.RealizedPnL)</b></div>
		<div>нереализованный
			@if (_data.HasMarkFailure)
			{
				@* Сбой марок — видимое состояние: нереализованная оценка не построена,
				   признак сбоя занимает её место; реализованный результат виден. *@
				@* Traceability: change:add-ui-screens/design#d4 *@
				<b class="markfail" title="Провайдер марок недоступен — нереализованный PnL не оценён">сбой марок</b>
			}
			else
			{
				<b>@FormatUnrealized(_data.Metrics.UnrealizedPnL)</b>
			}
		</div>
		<div>корректировки<b class="@SignClass(_data.Metrics.AdjustmentsPnL)">@FormatAdjustments(_data.Metrics.AdjustmentsPnL)</b></div>
		<div>марки на
			@if (_data.HasMarkFailure)
			{
				@* Нереализованные величины сопровождаются отметкой времени марок;
				   при сбое провайдера время получения марок неизвестно. *@
				@* Traceability: openspec:ui/screens#scenario-detail-summary-metrics-period *@
				<b class="markfail" title="Провайдер марок недоступен — время получения марок неизвестно">сбой марок</b>
			}
			else if (_data.HasOpenResidual == false)
			{
				<b title="Открытых остатков нет — марки оценке не нужны">не нужны</b>
			}
			else
			{
				<b>@MarksLabel</b>
			}
		</div>
		<div>период<b>@PeriodLabel</b></div>
	</div>

	@* Комментарий конструкции — в шапке деталей рядом со сводкой: правка
	   по месту открывает текстовое поле, сохранение перечитывает снимок
	   и сразу показывает новый текст без перезагрузки экрана. *@
	@* Traceability: openspec:ui/screens#requirement-comments-inline-editing *@
	<div class="detail-comment">
		<span>комментарий</span>
		@if (IsEditingComment(CommentTarget.Construction, null))
		{
			<span class="cell-editor">
				<input class="cell-input" placeholder="комментарий конструкции" @bind="_commentDraft" />
				<button type="button" class="btn cell-btn primary" disabled="@_busy" @onclick="SaveConstructionCommentAsync">Сохранить</button>
				<button type="button" class="btn cell-btn" disabled="@_busy" @onclick="CancelCommentEdit">Отмена</button>
			</span>
		}
		else
		{
			<span class="detail-comment-text">@(_data.Comment ?? "—")</span>
			<button type="button" class="btn cell-btn" disabled="@_busy" @onclick="() => BeginCommentEdit(CommentTarget.Construction, null, _data.Comment)">изменить</button>
		}
	</div>

	<h2>Позиции</h2>
	@if (_markFormSymbol is not null)
	{
		@* Форма ручной пометки закрытия над таблицей позиций: цена по умолчанию —
		   последняя известная марка инструмента из кэша провайдера, пустое поле
		   оставляет цену домену (марка подставится при чтении), время — текущее. *@
		@* Traceability: openspec:ui/screens#scenario-mark-form-defaults-last-mark *@
		<div class="action-form">
			<span class="action-warning">Закрыть позицию «@_markFormSymbol» пометкой</span>
			<label class="action-label">
				цена закрытия
				<input class="action-input" placeholder="пусто — последняя марка при чтении" @bind="_markPriceInput" />
			</label>
			@if (_markPriceInvalid)
			{
				<span class="validation-message">Введите число или оставьте поле пустым</span>
			}
			<label class="action-label">
				время пометки
				<input class="action-input" placeholder="2026-09-20 14:30" @bind="_markTimeInput" />
			</label>
			@if (_markTimeInvalid)
			{
				<span class="validation-message">Введите время в формате 2026-09-20 14:30</span>
			}
			<button type="button" class="btn primary" disabled="@_busy" @onclick="AddMarkAsync">Поставить пометку</button>
			<button type="button" class="btn" disabled="@_busy" @onclick="CancelMarkForm">Отмена</button>
		</div>
	}
	<table>
		<thead>
			<tr>
				<th>Инструмент</th>
				<th>Остаток</th>
				<th>Средняя</th>
				<th>Марка</th>
				<th>Нереализов.</th>
				<th>Статус</th>
				<th>Комментарий</th>
				<th>Действия</th>
			</tr>
		</thead>
		<tbody>
			@if (_data.Positions.Count == 0)
			{
				@* Пустая таблица — явное сообщение об отсутствии, а не пустая разметка. *@
				@* Traceability: openspec:ui/screens#scenario-detail-empty-table-message *@
				<tr><td colspan="8" class="empty">позиций нет</td></tr>
			}
			@foreach (var position in _data.Positions)
			{
				<tr>
					<td>@position.Symbol</td>
					<td>@FormatQuantity(position.Residual)</td>
					<td>@FormatAmount(position.AverageOpenPrice)</td>
					<td>
						@if (position.IsOpen && position.MarkPrice is null)
						{
							@* Открытому остатку марка не досталась — признак сбоя марок
							   на месте марки и нереализованной оценки позиции. *@
							@* Traceability: change:add-ui-screens/design#d4 *@
							<span class="markfail" title="Провайдер марок недоступен — марка не получена">сбой марок</span>
						}
						else
						{
							@FormatAmount(position.MarkPrice)
						}
					</td>
					<td>
						@if (position.IsOpen && position.UnrealizedPnL is null)
						{
							<span class="markfail" title="Провайдер марок недоступен — нереализованный PnL не оценён">сбой марок</span>
						}
						else
						{
							<span class="@SignClass(position.UnrealizedPnL)">@FormatUnrealized(position.UnrealizedPnL)</span>
						}
					</td>
					<td><span class="@(position.IsOpen ? "status status-open" : "status status-closed")">@(position.IsOpen ? "открыта" : "закрыта")</span></td>
					@* Комментарий позиции правится по месту строки; доступно только
					   текстовое поле комментария — остаток и прочие величины позиции
					   вводом не редактируются. *@
					@* Traceability: openspec:ui/screens#scenario-position-comment-without-residual-edit *@
					<td>
						@if (IsEditingComment(CommentTarget.Position, position.Symbol))
						{
							<span class="cell-editor">
								<input class="cell-input" placeholder="комментарий позиции" @bind="_commentDraft" />
								<button type="button" class="btn cell-btn primary" disabled="@_busy" @onclick="() => SavePositionCommentAsync(position.Symbol)">Сохранить</button>
								<button type="button" class="btn cell-btn" disabled="@_busy" @onclick="CancelCommentEdit">Отмена</button>
							</span>
						}
						else
						{
							<span>@(position.Comment ?? "—")</span>
							<button type="button" class="btn cell-btn" disabled="@_busy" @onclick="() => BeginCommentEdit(CommentTarget.Position, position.Symbol, position.Comment)">изменить</button>
						}
					</td>
					@* Позиция производная и вводом не редактируется: единственное действие
					   открытой строки — «закрыть пометкой», ставящее пользовательскую
					   закрывающую запись с формой цены и времени. *@
					@* Traceability: openspec:ui/screens#requirement-manual-close-mark-from-position *@
					<td>
						@if (position.IsOpen)
						{
							<button type="button" class="btn cell-btn" disabled="@_busy" @onclick="() => BeginCloseMarkAsync(position.Symbol)">закрыть пометкой…</button>
						}
						else
						{
							<span>—</span>
						}
					</td>
				</tr>
			}
		</tbody>
	</table>

	<h2>Сделки</h2>
	@if (_moveTradeExecId is not null)
	{
		@* Форма переноса сделки над таблицей сделок: выбор целевой конструкции
		   из активных без текущей; подтверждение переносит сделку, отмена
		   закрывает форму без изменения принадлежности. *@
		@* Traceability: openspec:ui/screens#scenario-detail-move-trade-choose-target *@
		<div class="action-form">
			@if (_moveTargets.Count == 0)
			{
				@* Переносить некуда — явное сообщение вместо пустого выбора:
				   пользователь сначала создаёт целевую конструкцию. *@
				<span class="action-warning">Нет других активных конструкций — сначала создайте целевую конструкцию.</span>
			}
			else
			{
				<label class="action-label">
					целевая конструкция
					<select class="action-input" @bind="_moveTargetId">
						@foreach (var target in _moveTargets)
						{
							<option value="@target.Id">@target.Name</option>
						}
					</select>
				</label>
				<button type="button" class="btn primary" disabled="@_busy" @onclick="MoveTradeAsync">Перенести</button>
			}
			<button type="button" class="btn" disabled="@_busy" @onclick="CancelMoveTrade">Отмена</button>
		</div>
	}
	<table>
		<thead>
			<tr>
				<th>Время</th>
				<th>execId</th>
				<th>Инструмент</th>
				<th>Направление</th>
				<th>Кол-во</th>
				<th>Цена</th>
				<th>Сумма</th>
				<th>Комиссия</th>
				<th>Комментарий</th>
				<th>Действия</th>
			</tr>
		</thead>
		<tbody>
			@if (_data.Trades.Count == 0)
			{
				@* Traceability: openspec:ui/screens#scenario-detail-empty-table-message *@
				<tr><td colspan="10" class="empty">сделок нет</td></tr>
			}
			@foreach (var trade in _data.Trades)
			{
				<tr>
					<td>@FormatDate(trade.ExecutedAt)</td>
					<td>@trade.ExecId</td>
					<td>@trade.Symbol</td>
					<td>@(trade.IsBuy ? "покупка" : "продажа")</td>
					<td>@FormatQuantity(trade.Quantity)</td>
					<td>@FormatAmount(trade.Price)</td>
					<td>@FormatAmount(trade.AmountUsdt)</td>
					<td>@FormatQuantity(trade.Fee)</td>
					@* Комментарий сделки правится в строке таблицы сделок: сохранение
					   перечитывает снимок и сразу показывает новый текст. *@
					@* Traceability: openspec:ui/screens#scenario-trade-comment-inline-edit *@
					<td>
						@if (IsEditingComment(CommentTarget.Trade, trade.ExecId))
						{
							<span class="cell-editor">
								<input class="cell-input" placeholder="комментарий сделки" @bind="_commentDraft" />
								<button type="button" class="btn cell-btn primary" disabled="@_busy" @onclick="() => SaveTradeCommentAsync(trade.ExecId)">Сохранить</button>
								<button type="button" class="btn cell-btn" disabled="@_busy" @onclick="CancelCommentEdit">Отмена</button>
							</span>
						}
						else
						{
							<span>@(trade.Comment ?? "—")</span>
							<button type="button" class="btn cell-btn" disabled="@_busy" @onclick="() => BeginCommentEdit(CommentTarget.Trade, trade.ExecId, trade.Comment)">изменить</button>
						}
					</td>
					@* Действия строки сделки: возврат во «Входящие» снимает привязку,
					   перенос назначает целевую конструкцию; производные пересчитываются
					   при очередном чтении, поэтому кнопки меняют только принадлежность. *@
					@* Traceability: openspec:ui/screens#requirement-trade-actions-in-detail *@
					<td>
						<button type="button" class="btn cell-btn" disabled="@_busy" @onclick="() => ReturnTradeAsync(trade.ExecId)">Во «Входящие»</button>
						<button type="button" class="btn cell-btn" disabled="@_busy" @onclick="() => BeginMoveTradeAsync(trade.ExecId)">Перенести…</button>
					</td>
				</tr>
			}
		</tbody>
	</table>

	<h2>Закрывающие записи</h2>
	@if (_data.ClosingWarnings.Count > 0)
	{
		@* Избыточная закрывающая запись не применяется и не блокирует чтение:
		   пометка к уже нулевому остатку либо запись, конкурирующая с delivery,
		   доходит до пользователя предупреждением о расхождении. *@
		@* Traceability: openspec:ui/screens#scenario-redundant-closing-entry-warned *@
		@foreach (var warning in _data.ClosingWarnings)
		{
			<p class="note note-error" role="alert">
				Избыточная закрывающая запись: @KindText(warning.Kind) «@warning.Symbol» на @FormatDate(warning.ClosedAt) —
				остаток позиции уже нулевой, запись не применена.
			</p>
		}
	}
	@if (_editMarkId is not null)
	{
		@* Форма правки ручной пометки над таблицей закрывающих записей: правятся
		   цена и время, значения предзаполнены эффективной ценой и временем записи;
		   пустая цена возвращает пометку к последней марке при чтении. *@
		@* Traceability: openspec:ui/screens#requirement-manual-close-mark-from-position *@
		<div class="action-form">
			<span class="action-warning">Правка ручной пометки «@_editMarkSymbol»</span>
			<label class="action-label">
				цена закрытия
				<input class="action-input" placeholder="пусто — последняя марка при чтении" @bind="_editPriceInput" />
			</label>
			@if (_editPriceInvalid)
			{
				<span class="validation-message">Введите число или оставьте поле пустым</span>
			}
