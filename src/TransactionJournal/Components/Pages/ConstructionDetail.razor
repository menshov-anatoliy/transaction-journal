			var right = _data.Metrics.ClosedAt is { } closedAt
				? FormatDate(closedAt)
				: "открыта";
			return $"{FormatDate(openedAt)} — {right} · {FormatDuration(_data.Metrics.Duration)}";
		}
	}

	/// <summary>Формат ввода и отображения времени пометки закрытия.</summary>
	private const string MarkTimeFormat = "yyyy-MM-dd HH:mm";

	/// <summary>Допустимые форматы ввода времени пометки закрытия.</summary>
	private static readonly string[] MarkTimeFormats = ["yyyy-MM-dd HH:mm", "yyyy-MM-ddTHH:mm"];

	/// <summary>Допустимые форматы ввода даты корректировки: день либо день со временем.</summary>
	private static readonly string[] AdjustmentDateFormats = ["yyyy-MM-dd", "yyyy-MM-dd HH:mm"];

	/// <summary>Знаковый класс величины: рост зелёным, падение красным, ноль без выделения.</summary>
	private static string SignClass(decimal? value) => value > 0 ? "pos" : value < 0 ? "neg" : string.Empty;

	/// <summary>Формат знаковой суммы USDT: «+214.32» / «-58.2» / «0».</summary>
	private static string FormatPnL(decimal value) =>
		value.ToString("+0.##;-0.##;0", CultureInfo.InvariantCulture);

	/// <summary>Нереализованный PnL: нулевая оценка — прочерк; признак сбоя марок выводится разметкой.</summary>
	private static string FormatUnrealized(decimal? value) => value == 0m ? "—" : FormatPnL(value.GetValueOrDefault());

	/// <summary>Сумма корректировок: без корректировок — прочерк.</summary>
	private static string FormatAdjustments(decimal value) => value == 0m ? "—" : FormatPnL(value);

	/// <summary>Формат процента от капитала: «+8.6%» / «-3.1%» / «0%»; недоступный — прочерк.</summary>
	private static string FormatPercent(decimal? value) => value is null
		? "—"
		: $"{value.Value.ToString("+0.#;-0.#;0", CultureInfo.InvariantCulture)}%";

	/// <summary>Количество или цена без знака: «0.0002» / «42000»; отсутствие — прочерк.</summary>
	private static string FormatAmount(decimal? value) => value is null
		? "—"
		: value.Value.ToString("0.####", CultureInfo.InvariantCulture);

	/// <summary>Знаковое количество остатка: «+0.0002» / «-0.0001» / «0».</summary>
	private static string FormatQuantity(decimal value) =>
		value.ToString("+0.####;-0.####;0", CultureInfo.InvariantCulture);

	/// <summary>Дата-время записи: «2026-06-20 14:30»; отсутствие — прочерк.</summary>
	private static string FormatDate(DateTimeOffset moment) =>
		moment.ToString(MarkTimeFormat, CultureInfo.InvariantCulture);

	/// <summary>Дата корректировки без времени: «2026-09-20».</summary>
	private static string FormatDay(DateTimeOffset moment) =>
		moment.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

	/// <summary>Длительность периода: «92 дн. 3 ч.» / «5 ч. 40 мин.»; отсутствие — прочерк.</summary>
	private static string FormatDuration(TimeSpan? duration)
	{
		if (duration is not { } value)
		{
			return "—";
		}

		var days = (int)value.TotalDays;
		if (days > 0)
		{
			return $"{days} дн. {value.Hours} ч.";
		}

		return value.Hours > 0
			? $"{value.Hours} ч. {value.Minutes} мин."
			: $"{value.Minutes} мин.";
	}

	/// <summary>Детали закрывающей записи: знаковое количество и цена закрытия; неизвестная цена названа словами.</summary>
	private static string ClosingDetails(ConstructionClosingEntryRow entry) => entry.Price is { } price
		? $"{FormatQuantity(entry.Quantity)} × {FormatAmount(price)}"
		: $"{FormatQuantity(entry.Quantity)} × марка неизвестна";

	/// <summary>Название вида закрывающей записи словами.</summary>
	private static string KindText(PositionClosingKind kind) => kind switch
	{
		PositionClosingKind.Delivery => "delivery",
		PositionClosingKind.OtmExpiry => "экспирация OTM",
		PositionClosingKind.ManualMark => "ручная пометка",
		_ => "неизвестен",
	};

	/// <summary>Название источника корректировки словами.</summary>
	private static string SourceText(PnLAdjustmentSource source) => source switch
	{
		PnLAdjustmentSource.Robot => "робот",
		PnLAdjustmentSource.Manual => "ручная",
		_ => "неизвестен",
	};

	/// <summary>Класс статуса конструкции в заголовке — цвет текста по ручному статусу.</summary>
	private static string StatusClass(ConstructionStatus status) => status switch
	{
		ConstructionStatus.Open => "status status-open",
		ConstructionStatus.Closed => "status status-closed",
		ConstructionStatus.Archived => "status status-archived",
		_ => "status",
	};

	/// <summary>Ручной статус конструкции словами.</summary>
	private static string StatusText(ConstructionStatus status) => status switch
	{
		ConstructionStatus.Open => "открыта",
		ConstructionStatus.Closed => "закрыта",
		ConstructionStatus.Archived => "архив",
		_ => "неизвестен",
	};

	#endregion
}
