@page "/constructions/{ConstructionId:long}"
@rendermode InteractiveServer

@using System.Globalization
@using TransactionJournal.Components.Layout
@using TransactionJournal.Components.Pages
@using TransactionJournal.Data
@using TransactionJournal.Domain
@inject IConstructionDetailReadModel Detail
@inject IConstructionService Constructions
@inject ICommentService Comments
@inject JournalChangeSignal Changes
@inject NavigationManager Navigation

<PageTitle>@(_data?.Name ?? "Конструкция") — Журнал Bybit</PageTitle>

@if (_unavailable)
{
	<h1>Конструкция</h1>
	@* Явное состояние вместо пустого экрана: журнал не прочитан — сводка и таблицы
	   не показываются, пользователь видит причину обновить экран. *@
	<p class="note">Журнал недоступен: не удалось прочитать данные конструкции. Обновите экран.</p>
}
else if (_notFound)
{
	<h1>Конструкция не найдена</h1>
	<p class="note">Конструкция @ConstructionId не найдена — возможно, она удалена. Вернитесь к списку конструкций.</p>
}
else if (_data is null)
{
	<h1>Конструкция</h1>
	<p class="note">Чтение журнала…</p>
}
else
{
	@* Транзитный экран деталей конструкции: адрес /constructions/{id} открывает
	   именованную вкладку каркаса; заголовок повторяет имя и ручной статус. *@
	<h1>@_data.Name <span class="@StatusClass(_data.Status)">@StatusText(_data.Status)</span></h1>

	@* Действия над конструкцией: свободное переименование, смена ручного
	   статуса между «открыта» и «закрыта», архивация с возвратом, изменение
	   выделенного капитала и удаление пустой с подтверждением. Мутации идут
	   сервисами домена, экран перечитывает снимок целиком после каждой. *@
	@* Traceability: openspec:ui/screens#requirement-construction-actions *@
	<div class="toolbar detail-actions">
		<button type="button" class="btn" disabled="@_busy" @onclick="BeginRename">Переименовать</button>
		@if (_data.Status == ConstructionStatus.Open)
		{
			@* Смена ручного статуса — свободный переход между «открыта» и «закрыта». *@
			<button type="button" class="btn" disabled="@_busy" @onclick="() => ChangeStatusAsync(ConstructionStatus.Closed)">Закрыть</button>
		}
		else if (_data.Status == ConstructionStatus.Closed)
		{
			<button type="button" class="btn" disabled="@_busy" @onclick="() => ChangeStatusAsync(ConstructionStatus.Open)">Открыть</button>
		}
		@if (_data.Status == ConstructionStatus.Archived)
		{
			@* Возврат из архива восстанавливает ручной статус «закрыта»: статус
			   до архивации журнал не хранит, а незаметное возвращение «открыта»
			   сделало бы конструкцию операционно активной без решения пользователя;
			   следующее «Открыть» переводит статус свободно. *@
			<button type="button" class="btn" disabled="@_busy" @onclick="() => ChangeStatusAsync(ConstructionStatus.Closed)">Вернуть из архива</button>
		}
		else
		{
			<button type="button" class="btn" disabled="@_busy" @onclick="() => ChangeStatusAsync(ConstructionStatus.Archived)">В архив</button>
		}
		<button type="button" class="btn" disabled="@_busy" @onclick="BeginCapitalChange">Изменить капитал</button>
		@if (CanDelete)
		{
			@* Удаление предлагается только конструкции без сделок и корректировок:
			   кнопки у непустой нет, пользователь снимает записи прежде удаления. *@
			<button type="button" class="btn danger" disabled="@_busy" @onclick="BeginDelete">Удалить…</button>
		}
	</div>

	@if (_actionError is not null)
	{
		@* Отказ действия доходит причиной: пользователь видит, что именно
		   блокирует изменение, экран и данные остаются без изменений. *@
		<p class="note note-error" role="alert">@_actionError</p>
	}

	@if (_action == DetailAction.Rename)
	{
		@* Форма переименования: свободная правка имени, остальные данные
		   конструкции не затрагиваются. *@
		<div class="action-form">
			<label class="action-label">
				новое имя
				<input class="action-input" maxlength="200" @bind="_renameValue" />
			</label>
			<button type="button" class="btn primary" disabled="@_busy" @onclick="RenameAsync">Сохранить имя</button>
			<button type="button" class="btn" disabled="@_busy" @onclick="CancelAction">Отмена</button>
		</div>
	}
	else if (_action == DetailAction.Capital)
	{
		@* Форма капитала: значение в USDT; правка капитала меняет только
		   процентные величины, абсолютный результат не затрагивается. *@
		<div class="action-form">
			<label class="action-label">
				выделенный капитал, USDT
				<input class="action-input" @bind="_capitalInput" />
			</label>
			<button type="button" class="btn primary" disabled="@_busy" @onclick="ChangeCapitalAsync">Сохранить капитал</button>
			<button type="button" class="btn" disabled="@_busy" @onclick="CancelAction">Отмена</button>
			@if (_capitalInvalid)
			{
				<span class="validation-message">Введите число в USDT, например 3000</span>
			}
		</div>
	}
	else if (_action == DetailAction.Delete)
	{
		@* Удаление требует явного подтверждения: подтверждение — отдельный шаг,
		   без него команда удаления не запускается. *@
		<div class="action-form">
			<span class="action-warning">Удалить пустую конструкцию «@_data.Name»? Действие необратимо.</span>
			<button type="button" class="btn danger" disabled="@_busy" @onclick="DeleteAsync">Удалить</button>
			<button type="button" class="btn" disabled="@_busy" @onclick="CancelAction">Отмена</button>
		</div>
	}

	@* Сводка метрик конструкции: итог, процент от капитала, разбивка по
	   реализованному и нереализованному результату, сумма корректировок,
	   период с длительностью и отметка времени марок оценки. *@
	@* Traceability: openspec:ui/screens#requirement-construction-detail-screen *@
	<div class="kstrip">
		<div>итог
			@if (_data.Metrics.TotalPnL is null)
			{
				@* Итог без нереализованной части неполный — признак сбоя марок,
				   а не прочерк «нулевого» итога. *@
				@* Traceability: change:add-ui-screens/design#d4 *@
				<b class="markfail" title="Итог неполный: нереализованная часть не оценена из-за сбоя марок">неполный (сбой марок)</b>
			}
			else
			{
				<b class="@SignClass(_data.Metrics.TotalPnL)">@FormatPnL(_data.Metrics.TotalPnL.Value) USDT</b>
			}
		</div>
		<div>% капитала (@FormatAmount(_data.AllocatedCapitalUsdt))<b class="@SignClass(_data.Metrics.TotalPnLPercent)">@FormatPercent(_data.Metrics.TotalPnLPercent)</b></div>
		<div>реализованный<b class="@SignClass(_data.Metrics.RealizedPnL)">@FormatPnL(_data.Metrics.RealizedPnL)</b></div>
		<div>нереализованный
			@if (_data.HasMarkFailure)
			{
				@* Сбой марок — видимое состояние: нереализованная оценка не построена,
				   признак сбоя занимает её место; реализованный результат виден. *@
				@* Traceability: change:add-ui-screens/design#d4 *@
				<b class="markfail" title="Провайдер марок недоступен — нереализованный PnL не оценён">сбой марок</b>
			}
			else
			{
				<b>@FormatUnrealized(_data.Metrics.UnrealizedPnL)</b>
			}
		</div>
		<div>корректировки<b class="@SignClass(_data.Metrics.AdjustmentsPnL)">@FormatAdjustments(_data.Metrics.AdjustmentsPnL)</b></div>
		<div>марки на
			@if (_data.HasMarkFailure)
			{
				@* Нереализованные величины сопровождаются отметкой времени марок;
				   при сбое провайдера время получения марок неизвестно. *@
				@* Traceability: openspec:ui/screens#scenario-detail-summary-metrics-period *@
				<b class="markfail" title="Провайдер марок недоступен — время получения марок неизвестно">сбой марок</b>
			}
			else if (_data.HasOpenResidual == false)
			{
				<b title="Открытых остатков нет — марки оценке не нужны">не нужны</b>
			}
			else
			{
				<b>@MarksLabel</b>
			}
		</div>
		<div>период<b>@PeriodLabel</b></div>
	</div>

	@* Комментарий конструкции — в шапке деталей рядом со сводкой: правка
	   по месту открывает текстовое поле, сохранение перечитывает снимок
	   и сразу показывает новый текст без перезагрузки экрана. *@
	@* Traceability: openspec:ui/screens#requirement-comments-inline-editing *@
	<div class="detail-comment">
		<span>комментарий</span>
		@if (IsEditingComment(CommentTarget.Construction, null))
		{
			<span class="cell-editor">
				<input class="cell-input" placeholder="комментарий конструкции" @bind="_commentDraft" />
				<button type="button" class="btn cell-btn primary" disabled="@_busy" @onclick="SaveConstructionCommentAsync">Сохранить</button>
				<button type="button" class="btn cell-btn" disabled="@_busy" @onclick="CancelCommentEdit">Отмена</button>
			</span>
		}
		else
		{
			<span class="detail-comment-text">@(_data.Comment ?? "—")</span>
			<button type="button" class="btn cell-btn" disabled="@_busy" @onclick="() => BeginCommentEdit(CommentTarget.Construction, null, _data.Comment)">изменить</button>
		}
	</div>

	<h2>Позиции</h2>
	<table>
		<thead>
			<tr>
				<th>Инструмент</th>
				<th>Остаток</th>
				<th>Средняя</th>
				<th>Марка</th>
				<th>Нереализов.</th>
				<th>Статус</th>
				<th>Комментарий</th>
			</tr>
		</thead>
		<tbody>
			@if (_data.Positions.Count == 0)
			{
				@* Пустая таблица — явное сообщение об отсутствии, а не пустая разметка. *@
				@* Traceability: openspec:ui/screens#scenario-detail-empty-table-message *@
				<tr><td colspan="7" class="empty">позиций нет</td></tr>
			}
			@foreach (var position in _data.Positions)
			{
				<tr>
					<td>@position.Symbol</td>
					<td>@FormatQuantity(position.Residual)</td>
					<td>@FormatAmount(position.AverageOpenPrice)</td>
					<td>
						@if (position.IsOpen && position.MarkPrice is null)
						{
							@* Открытому остатку марка не досталась — признак сбоя марок
							   на месте марки и нереализованной оценки позиции. *@
							@* Traceability: change:add-ui-screens/design#d4 *@
							<span class="markfail" title="Провайдер марок недоступен — марка не получена">сбой марок</span>
						}
						else
						{
							@FormatAmount(position.MarkPrice)
						}
					</td>
					<td>
						@if (position.IsOpen && position.UnrealizedPnL is null)
						{
							<span class="markfail" title="Провайдер марок недоступен — нереализованный PnL не оценён">сбой марок</span>
						}
						else
						{
							<span class="@SignClass(position.UnrealizedPnL)">@FormatUnrealized(position.UnrealizedPnL)</span>
						}
					</td>
					<td><span class="@(position.IsOpen ? "status status-open" : "status status-closed")">@(position.IsOpen ? "открыта" : "закрыта")</span></td>
					@* Комментарий позиции правится по месту строки; доступно только
					   текстовое поле комментария — остаток и прочие величины позиции
					   вводом не редактируются. *@
					@* Traceability: openspec:ui/screens#scenario-position-comment-without-residual-edit *@
					<td>
						@if (IsEditingComment(CommentTarget.Position, position.Symbol))
						{
							<span class="cell-editor">
								<input class="cell-input" placeholder="комментарий позиции" @bind="_commentDraft" />
								<button type="button" class="btn cell-btn primary" disabled="@_busy" @onclick="() => SavePositionCommentAsync(position.Symbol)">Сохранить</button>
								<button type="button" class="btn cell-btn" disabled="@_busy" @onclick="CancelCommentEdit">Отмена</button>
							</span>
						}
						else
						{
							<span>@(position.Comment ?? "—")</span>
							<button type="button" class="btn cell-btn" disabled="@_busy" @onclick="() => BeginCommentEdit(CommentTarget.Position, position.Symbol, position.Comment)">изменить</button>
						}
					</td>
				</tr>
			}
		</tbody>
	</table>

	<h2>Сделки</h2>
	<table>
		<thead>
			<tr>
				<th>Время</th>
				<th>execId</th>
				<th>Инструмент</th>
				<th>Направление</th>
				<th>Кол-во</th>
				<th>Цена</th>
				<th>Сумма</th>
				<th>Комиссия</th>
				<th>Комментарий</th>
			</tr>
		</thead>
		<tbody>
			@if (_data.Trades.Count == 0)
			{
				@* Traceability: openspec:ui/screens#scenario-detail-empty-table-message *@
				<tr><td colspan="9" class="empty">сделок нет</td></tr>
			}
			@foreach (var trade in _data.Trades)
			{
				<tr>
					<td>@FormatDate(trade.ExecutedAt)</td>
					<td>@trade.ExecId</td>
					<td>@trade.Symbol</td>
					<td>@(trade.IsBuy ? "покупка" : "продажа")</td>
					<td>@FormatQuantity(trade.Quantity)</td>
					<td>@FormatAmount(trade.Price)</td>
					<td>@FormatAmount(trade.AmountUsdt)</td>
					<td>@FormatQuantity(trade.Fee)</td>
					@* Комментарий сделки правится в строке таблицы сделок: сохранение
					   перечитывает снимок и сразу показывает новый текст. *@
					@* Traceability: openspec:ui/screens#scenario-trade-comment-inline-edit *@
					<td>
						@if (IsEditingComment(CommentTarget.Trade, trade.ExecId))
						{
							<span class="cell-editor">
								<input class="cell-input" placeholder="комментарий сделки" @bind="_commentDraft" />
								<button type="button" class="btn cell-btn primary" disabled="@_busy" @onclick="() => SaveTradeCommentAsync(trade.ExecId)">Сохранить</button>
								<button type="button" class="btn cell-btn" disabled="@_busy" @onclick="CancelCommentEdit">Отмена</button>
							</span>
						}
						else
						{
							<span>@(trade.Comment ?? "—")</span>
							<button type="button" class="btn cell-btn" disabled="@_busy" @onclick="() => BeginCommentEdit(CommentTarget.Trade, trade.ExecId, trade.Comment)">изменить</button>
						}
					</td>
				</tr>
			}
		</tbody>
	</table>

	<h2>Закрывающие записи</h2>
	@* Единый поток закрывающих записей: delivery, экспирации OTM и ручные
	   пометки перечисляются с типом, инструментом и суммой закрытия. *@
	@* Traceability: openspec:ui/screens#scenario-detail-closing-entries-shown *@
	<table>
		<thead>
			<tr>
				<th>Время</th>
				<th>Тип</th>
				<th>Инструмент</th>
				<th>Детали</th>
				<th>Сумма</th>
			</tr>
		</thead>
		<tbody>
			@if (_data.ClosingEntries.Count == 0)
			{
				@* Traceability: openspec:ui/screens#scenario-detail-empty-table-message *@
				<tr><td colspan="5" class="empty">закрывающих записей нет</td></tr>
			}
			@foreach (var entry in _data.ClosingEntries)
			{
				<tr>
					<td>@FormatDate(entry.ClosedAt)</td>
					<td>@KindText(entry.Kind)</td>
					<td>@entry.Symbol</td>
					<td>@ClosingDetails(entry)</td>
					<td>
						@if (entry.AmountUsdt is null)
						{
							<span class="markfail" title="Марка инструмента неизвестна — сумма закрытия не вычислена">—</span>
						}
						else
						{
							<span class="@SignClass(entry.AmountUsdt)">@FormatPnL(entry.AmountUsdt.Value)</span>
						}
					</td>
				</tr>
			}
		</tbody>
	</table>

	<h2>Корректировки PnL</h2>
	<table>
		<thead>
			<tr>
				<th>Дата</th>
				<th>Описание</th>
				<th>Источник</th>
				<th>Сумма</th>
			</tr>
		</thead>
		<tbody>
			@if (_data.Adjustments.Count == 0)
			{
				@* Traceability: openspec:ui/screens#scenario-detail-empty-table-message *@
				<tr><td colspan="4" class="empty">корректировок нет</td></tr>
			}
			@foreach (var adjustment in _data.Adjustments)
			{
				<tr>
					<td>@FormatDate(adjustment.Date)</td>
					<td>@(adjustment.Description ?? "—")</td>
					<td>@SourceText(adjustment.Source)</td>
					<td><span class="@SignClass(adjustment.AmountUsdt)">@FormatPnL(adjustment.AmountUsdt)</span></td>
				</tr>
			}
		</tbody>
	</table>
}

@code {
	/// <summary>Идентификатор открытой конструкции из адреса деталей.</summary>
	[Parameter] public long ConstructionId { get; set; }

	/// <summary>Открытая форма действия: пустая — действий не начато, удаление живёт до подтверждения.</summary>
	private enum DetailAction
	{
		None,
		Rename,
		Capital,
		Delete,
	}

	private ConstructionDetailData? _data;
	private bool _unavailable;
	private bool _notFound;
	private DetailAction _action;
	private string? _actionError;
	private bool _busy;
	private string _renameValue = string.Empty;
	private string _capitalInput = string.Empty;
	private bool _capitalInvalid;

	/// <summary>Уровень редактируемого комментария: сделка, позиция или сама конструкция.</summary>
	private enum CommentTarget
	{
		None,
		Construction,
		Trade,
		Position,
	}

	/// <summary>Открытая inline-правка комментария: уровень и ключ строки (execId либо инструмент).</summary>
	private CommentTarget _commentTarget = CommentTarget.None;
	private string? _commentKey;
	private string _commentDraft = string.Empty;

	/// <summary>
	/// Перечитывает данные экрана при каждом открытии деталей и смене конструкции:
	/// сводка, таблицы и комментарии всегда выведены из текущего состояния журнала.
	/// </summary>
	// Данные перечитываются из read-моделей при каждом открытии экрана — устаревших
	// значений UI не показывает.
	// Traceability: change:add-ui-screens/design#d7
	protected override async Task OnParametersSetAsync() => await ReloadAsync();

	/// <summary>
	/// Удаление предлагается только конструкции без сделок и внешних корректировок
	/// PnL: у конструкции с записями кнопки удаления нет.
	/// </summary>
	// Кнопка удаления присутствует только у пустой конструкции; окончательную
	// гарантию даёт домен — его отказ доходит причиной.
	// Traceability: openspec:ui/screens#requirement-construction-actions
	private bool CanDelete => _data is { } data && data.Trades.Count == 0 && data.Adjustments.Count == 0;

	/// <summary>
	/// Читает снимок экрана из read-модели деталей: открытие, смена конструкции
	/// и каждое выполненное действие перечитывают сводку и таблицы целиком —
	/// устаревших значений экран не показывает.
	/// </summary>
	private async Task ReloadAsync()
	{
		try
		{
			_data = await Detail.ReadAsync(ConstructionId);
			_unavailable = false;
			_notFound = false;
		}
		catch (ConstructionNotFoundException)
		{
			// Конструкция удалена или адрес указывает на несуществующую — экран
			// сообщает об отсутствии, а не показывает пустые таблицы.
			_data = null;
			_notFound = true;
			_unavailable = false;
		}
		catch (Exception)
		{
			// Повреждённое сырьё или недоступная база не оставляют пользователя
			// с пустым экраном: детали показывают явное состояние недоступности.
			_data = null;
			_unavailable = true;
			_notFound = false;
		}
	}

	#region Действия над конструкцией

	/// <summary>Открывает форму переименования с текущим именем конструкции.</summary>
	private void BeginRename()
	{
		if (_data is not { } data)
		{
			return;
		}

		_action = DetailAction.Rename;
		_renameValue = data.Name;
		_capitalInvalid = false;
		_actionError = null;
	}

	/// <summary>Открывает форму капитала с текущим значением выделенного капитала.</summary>
	private void BeginCapitalChange()
	{
		if (_data is not { } data)
		{
			return;
		}

		_action = DetailAction.Capital;
		_capitalInput = FormatAmount(data.AllocatedCapitalUsdt);
		_capitalInvalid = false;
		_actionError = null;
	}

	/// <summary>Открывает подтверждение удаления; без подтверждения команда не запускается.</summary>
	private void BeginDelete()
	{
		_action = DetailAction.Delete;
		_capitalInvalid = false;
		_actionError = null;
	}

	/// <summary>Закрывает открытую форму действия без выполнения команды.</summary>
	private void CancelAction()
	{
		_action = DetailAction.None;
		_capitalInvalid = false;
		_actionError = null;
	}

	/// <summary>
	/// Выполняет свободное переименование конструкции: сохраняется имя, экран
	/// и транзитная вкладка перечитывают заголовок.
	/// </summary>
	// Переименование затрагивает только имя: привязки, капитал, статус и
	// производные величины не изменяются.
	// Traceability: openspec:ui/screens#requirement-construction-actions
	private Task RenameAsync() => RunActionAsync(
		() => Constructions.RenameAsync(ConstructionId, _renameValue.Trim()),
		"Переименование не выполнено");

	/// <summary>
	/// Меняет ручной статус конструкции — «открыта», «закрыта» или «архив»:
	/// экран и статусная точка транзитной вкладки отражают новый статус.
	/// </summary>
	// Статусный бейдж деталей и точка вкладки обновляются сразу после действия.
	// Traceability: openspec:ui/screens#scenario-detail-status-change-indicated
	private Task ChangeStatusAsync(ConstructionStatus status) => RunActionAsync(
		() => Constructions.ChangeStatusAsync(ConstructionId, status),
		"Смена статуса не выполнена");

	/// <summary>
	/// Меняет выделенный капитал: проценты результата пересчитываются при
	/// следующем чтении, абсолютные величины и позиции не затрагиваются.
	/// </summary>
	// Капитал — база процентов: экран перечитывает снимок, процент от капитала
	// в сводке пересчитывается немедленно, абсолютные величины остаются.
	// Traceability: openspec:ui/screens#scenario-detail-capital-change-percent-only
	private Task ChangeCapitalAsync()
	{
		// Нечисловое значение капитала не уходит в домен: форма просит
		// корректное число, команда не выполняется.
		if (decimal.TryParse(_capitalInput, NumberStyles.Number, CultureInfo.InvariantCulture, out var capital) == false)
		{
			_capitalInvalid = true;
			return Task.CompletedTask;
		}

		_capitalInvalid = false;
		return RunActionAsync(
			() => Constructions.UpdateAllocatedCapitalAsync(ConstructionId, capital),
			"Изменение капитала не выполнено");
	}

	/// <summary>
	/// Удаляет пустую конструкцию после подтверждения и возвращает пользователя
	/// к списку; отказ домена доходит причиной, конструкция остаётся на экране.
	/// </summary>
	// Отказ удаления показывает причину — какие записи блокируют удаление;
	// успешное удаление закрывает экран деталей переходом к списку.
	// Traceability: openspec:ui/screens#scenario-detail-delete-refused-with-reason
	private async Task DeleteAsync()
	{
		await RunActionAsync(
			() => Constructions.DeleteAsync(ConstructionId),
			"Удаление не выполнено");

		// Экран удалённой конструкции закрывается: пользователь возвращается
		// к списку конструкций.
		if (_actionError is null)
		{
			Navigation.NavigateTo("/");
		}
	}

	/// <summary>
	/// Выполняет команду действия через сервис домена: успех перечитывает снимок
	/// экрана и оповещает каркас сигналом изменений; ошибки домена доходят
	/// текстом причины, данные и экран остаются без изменений.
	/// </summary>
	private async Task RunActionAsync(Func<Task> action, string errorPrefix)
	{
		if (_busy)
		{
			return;
		}

		_busy = true;
		_actionError = null;
		try
		{
			await action();
		}
		catch (ArgumentException)
		{
			// Пустое имя и подобные ошибки ввода — повод исправить форму,
			// команда в домен не прошла.
			_actionError = "Действие не выполнено: проверьте заполненные поля.";
			_busy = false;
			return;
		}
		catch (ConstructionDeletionRefusedException ex)
		{
			// Отказ удаления объясняет причину: пользователь видит блокирующие
			// записи, конструкция и её данные остаются неизменными.
			_actionError = ex.Message;
			_busy = false;
			await ReloadAsync();
			return;
		}
		catch (ConstructionNotFoundException)
		{
			// Конструкция исчезла между чтением и действием: экран перечитывает
			// состояние и сообщает об отсутствии.
			_busy = false;
			await ReloadAsync();
			return;
		}
		catch (Exception ex)
		{
			_actionError = $"{errorPrefix}: {ex.Message}";
			_busy = false;
			return;
		}

		_action = DetailAction.None;
		_capitalInvalid = false;
		// Успешное действие перечитало снимок целиком: открытая inline-правка
		// комментария закрывается, строки показывают актуальный текст.
		_commentTarget = CommentTarget.None;
		_commentKey = null;
		_busy = false;

		// Действие меняет данные экрана и каркаса: снимок перечитывается целиком,
		// каркас обновляет панель по сигналу изменений журнала.
		await ReloadAsync();
		await Changes.RaiseAsync();
	}

	#endregion

	#region Inline-правка комментариев

	/// <summary>
	/// Проверяет, открыта ли inline-правка комментария этого уровня и ключа:
	/// редактируется один комментарий одновременно.
	/// </summary>
	private bool IsEditingComment(CommentTarget target, string? key) =>
		_commentTarget == target && _commentKey == key;

	/// <summary>
	/// Открывает правку комментария своего уровня: сделка — в строке таблицы
	/// сделок, позиция — в строке таблицы позиций, конструкция — в шапке деталей;
	/// черновик стартует текущим текстом комментария.
	/// </summary>
	// Комментарии редактируются на месте своего уровня, без отдельных страниц.
	// Traceability: openspec:ui/screens#requirement-comments-inline-editing
	private void BeginCommentEdit(CommentTarget target, string? key, string? current)
	{
		_commentTarget = target;
		_commentKey = key;
		_commentDraft = current ?? string.Empty;
		_actionError = null;
	}

	/// <summary>Закрывает правку комментария без сохранения — текст остаётся прежним.</summary>
	private void CancelCommentEdit()
	{
		_commentTarget = CommentTarget.None;
		_commentKey = null;
		_actionError = null;
	}

	/// <summary>
	/// Сохраняет комментарий сделки: домен пишет текст по ключу execId, экран
	/// перечитывает снимок и сразу показывает новый текст в строке сделки.
	/// </summary>
	// Новый текст сохраняется и сразу виден в строке сделки.
	// Traceability: openspec:ui/screens#scenario-trade-comment-inline-edit
	private Task SaveTradeCommentAsync(string execId) => RunActionAsync(
		() => Comments.SetTradeCommentAsync(execId, _commentDraft),
		"Комментарий сделки не сохранён");

	/// <summary>
	/// Сохраняет комментарий позиции по ключу «конструкция × инструмент»:
	/// правится только текст комментария, остаток позиции не редактируется.
	/// </summary>
	// Доступно только текстовое поле комментария — остаток позиции вводом не меняется.
	// Traceability: openspec:ui/screens#scenario-position-comment-without-residual-edit
	private Task SavePositionCommentAsync(string symbol) => RunActionAsync(
		() => Comments.SetPositionCommentAsync(ConstructionId, symbol, _commentDraft),
		"Комментарий позиции не сохранён");

	/// <summary>Сохраняет комментарий конструкции в шапке деталей конструкции.</summary>
	// Комментарий конструкции редактируется в шапке деталей, рядом со сводкой.
	// Traceability: openspec:ui/screens#requirement-comments-inline-editing
	private Task SaveConstructionCommentAsync() => RunActionAsync(
		() => Comments.SetConstructionCommentAsync(ConstructionId, _commentDraft),
		"Комментарий конструкции не сохранён");

	#endregion

	#region Форматирование

	/// <summary>Отметка времени марок оценки; прочерк, когда оценка марок не оставила времени.</summary>
	private string MarksLabel => _data?.MarksAsOf is { } marks
		? FormatDate(marks)
		: "—";

	/// <summary>
	/// Период конструкции: даты открытия и закрытия с длительностью; у открытой —
	/// от первой сделки до сих пор, без сделок — прочерк.
	/// </summary>
	private string PeriodLabel
	{
		get
		{
			if (_data?.Metrics.OpenedAt is not { } openedAt)
			{
				return "—";
			}

			var right = _data.Metrics.ClosedAt is { } closedAt
				? FormatDate(closedAt)
				: "открыта";
			return $"{FormatDate(openedAt)} — {right} · {FormatDuration(_data.Metrics.Duration)}";
		}
	}

	/// <summary>Знаковый класс величины: рост зелёным, падение красным, ноль без выделения.</summary>
	private static string SignClass(decimal? value) => value > 0 ? "pos" : value < 0 ? "neg" : string.Empty;

	/// <summary>Формат знаковой суммы USDT: «+214.32» / «-58.2» / «0».</summary>
	private static string FormatPnL(decimal value) =>
		value.ToString("+0.##;-0.##;0", CultureInfo.InvariantCulture);

	/// <summary>Нереализованный PnL: нулевая оценка — прочерк; признак сбоя марок выводится разметкой.</summary>
	private static string FormatUnrealized(decimal? value) => value == 0m ? "—" : FormatPnL(value.GetValueOrDefault());

	/// <summary>Сумма корректировок: без корректировок — прочерк.</summary>
	private static string FormatAdjustments(decimal value) => value == 0m ? "—" : FormatPnL(value);

	/// <summary>Формат процента от капитала: «+8.6%» / «-3.1%» / «0%»; недоступный — прочерк.</summary>
	private static string FormatPercent(decimal? value) => value is null
		? "—"
		: $"{value.Value.ToString("+0.#;-0.#;0", CultureInfo.InvariantCulture)}%";

	/// <summary>Количество или цена без знака: «0.0002» / «42000»; отсутствие — прочерк.</summary>
	private static string FormatAmount(decimal? value) => value is null
		? "—"
		: value.Value.ToString("0.####", CultureInfo.InvariantCulture);

	/// <summary>Знаковое количество остатка: «+0.0002» / «-0.0001» / «0».</summary>
	private static string FormatQuantity(decimal value) =>
		value.ToString("+0.####;-0.####;0", CultureInfo.InvariantCulture);

	/// <summary>Дата-время записи: «2026-06-20 14:30»; отсутствие — прочерк.</summary>
	private static string FormatDate(DateTimeOffset moment) =>
		moment.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);

	/// <summary>Длительность периода: «92 дн. 3 ч.» / «5 ч. 40 мин.»; отсутствие — прочерк.</summary>
	private static string FormatDuration(TimeSpan? duration)
	{
		if (duration is not { } value)
		{
			return "—";
		}

		var days = (int)value.TotalDays;
		if (days > 0)
		{
			return $"{days} дн. {value.Hours} ч.";
		}

		return value.Hours > 0
			? $"{value.Hours} ч. {value.Minutes} мин."
			: $"{value.Minutes} мин.";
	}

	/// <summary>Детали закрывающей записи: знаковое количество и цена закрытия; неизвестная цена названа словами.</summary>
	private static string ClosingDetails(ConstructionClosingEntryRow entry) => entry.Price is { } price
		? $"{FormatQuantity(entry.Quantity)} × {FormatAmount(price)}"
		: $"{FormatQuantity(entry.Quantity)} × марка неизвестна";

	/// <summary>Название вида закрывающей записи словами.</summary>
	private static string KindText(PositionClosingKind kind) => kind switch
	{
		PositionClosingKind.Delivery => "delivery",
		PositionClosingKind.OtmExpiry => "экспирация OTM",
		PositionClosingKind.ManualMark => "ручная пометка",
		_ => "неизвестен",
	};

	/// <summary>Название источника корректировки словами.</summary>
	private static string SourceText(PnLAdjustmentSource source) => source switch
	{
		PnLAdjustmentSource.Robot => "робот",
		PnLAdjustmentSource.Manual => "ручная",
		_ => "неизвестен",
	};

	/// <summary>Класс статуса конструкции в заголовке — цвет текста по ручному статусу.</summary>
	private static string StatusClass(ConstructionStatus status) => status switch
	{
		ConstructionStatus.Open => "status status-open",
		ConstructionStatus.Closed => "status status-closed",
		ConstructionStatus.Archived => "status status-archived",
		_ => "status",
	};

	/// <summary>Ручной статус конструкции словами.</summary>
	private static string StatusText(ConstructionStatus status) => status switch
	{
		ConstructionStatus.Open => "открыта",
		ConstructionStatus.Closed => "закрыта",
		ConstructionStatus.Archived => "архив",
		_ => "неизвестен",
	};

	#endregion
}
