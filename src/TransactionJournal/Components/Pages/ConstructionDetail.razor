	/// Переносит сделку в выбранную конструкцию: после подтверждения сделка
	/// принадлежит ровно одной — целевой — конструкции; успех закрывает форму
	/// и перечитывает снимок, отказ домена оставляет форму открытой с причиной.
	/// </summary>
	// Привязка к цели заменяет прежнюю принадлежность: у сделки не появляется
	// второй конструкции, обе затронутые перечитывают производные при чтении.
	// Traceability: openspec:ui/screens#scenario-detail-move-trade-choose-target
	private async Task MoveTradeAsync()
	{
		if (_moveTradeExecId is not { } execId || _moveTargetId is not { } targetId)
		{
			return;
		}

		await RunActionAsync(
			() => Bindings.BindAsync(targetId, execId),
			"Перенос сделки не выполнен");

		// Форма закрывается только успехом: отказ оставляет её открытой,
		// пользователь видит причину и может повторить или отменить перенос.
		if (_actionError is null)
		{
			CancelMoveTrade();
		}
	}

