@page "/inbox"

@rendermode InteractiveServer

@using System.Globalization
@using Microsoft.Extensions.DependencyInjection
@using TransactionJournal.Components.Layout
@using TransactionJournal.Data
@using TransactionJournal.Domain
@using TransactionJournal.Materialization
@inject InboxReadModel InboxModel
@inject IConstructionService Constructions
@inject ITradeBindingService Bindings
@inject JournalChangeSignal Changes

<PageTitle>Входящие — Журнал Bybit</PageTitle>

<h1>Входящие</h1>

@if (_actionError is not null)
{
	@* Отказ команды разбора доходит причиной: формы и выбор остаются на месте,
	   пользователь видит, что именно блокирует действие. *@
	<p class="note note-error" role="alert">@_actionError</p>
}

@* Тулбар разбора выбранных: обе команды недоступны при пустом выборе —
   действие без сделок не имеет смысла и блокируется, а не молчит. *@
@* Traceability: openspec:ui/screens#requirement-inbox-screen *@
<div class="toolbar">
	<button type="button" class="btn" disabled="@(HasNoSelection || _busy)" @onclick="BeginBindAsync">Привязать к конструкции…</button>
	<button type="button" class="btn" disabled="@(HasNoSelection || _busy)" @onclick="BeginCreateAsync">Создать конструкцию из выбранных…</button>
</div>

@if (_bindTargets is not null)
{
	@* Форма массовой привязки: целевая конструкция выбирается из активных;
	   успешная привязка забирает все выбранные сделки в одну конструкцию. *@
	@* Traceability: openspec:ui/screens#scenario-inbox-batch-bind-clears *@
	<div class="action-form">
		@if (_bindTargets.Count == 0)
		{
			<span class="action-warning">Нет активных конструкций — сначала создайте целевую конструкцию.</span>
		}
		else
		{
			<label class="action-label">
				целевая конструкция
				<select class="action-input" @bind="_bindTargetId">
					@foreach (var target in _bindTargets)
					{
						<option value="@target.Id">@target.Name</option>
					}
				</select>
			</label>
			<button type="button" class="btn primary" disabled="@_busy" @onclick="ConfirmBindAsync">Привязать выбранное</button>
		}
		<button type="button" class="btn" disabled="@_busy" @onclick="CancelBind">Отмена</button>
	</div>
}

@if (_createFormOpen)
{
	@* Форма создания конструкции из выбранных: имя и выделенный капитал;
	   новая конструкция открывается со статусом «открыта» и забирает все
	   выбранные сделки. *@
	@* Traceability: openspec:ui/screens#scenario-inbox-create-construction-from-selected *@
	<div class="action-form">
		<label class="action-label">
			имя конструкции
			<input class="action-input" maxlength="200" @bind="_createNameInput" />
		</label>
		@if (_createNameInvalid)
		{
			<span class="validation-message">Введите имя конструкции</span>
		}
		@* Поле капитала необязательно: пустой ввод создаёт конструкцию без
		   выделенного бюджета, процентные величины у неё не вычисляются. *@
		@* Traceability: openspec:ui/screens#scenario-inbox-create-without-capital *@
		<label class="action-label">
			Выделенный капитал, USDT
			<input class="action-input" placeholder="3000" @bind="_createCapitalInput" />
		</label>
		@if (_createCapitalInvalid)
		{
			<span class="validation-message">Введите число в USDT, например 3000</span>
		}
		<button type="button" class="btn primary" disabled="@_busy" @onclick="ConfirmCreateAsync">Создать и привязать</button>
		<button type="button" class="btn" disabled="@_busy" @onclick="CancelCreate">Отмена</button>
	</div>
}

@if (_unavailable)
{
	@* Повреждённое сырьё или недоступная база не оставляют пользователя с пустым
	   экраном: «Входящие» показывают явное состояние недоступности. *@
	<p class="note">Журнал недоступен: не удалось прочитать непривязанные сделки. Обновите экран.</p>
}
else if (_trades is null)
{
	<p class="note">Чтение журнала…</p>
}
else if (_trades.Count == 0)
{
	@* Пустые «Входящие» — явное сообщение об отсутствии, а не пустая разметка. *@
	<p class="note">Входящие пусты: непривязанных сделок нет.</p>
}
else
{
	@* Блок фильтров над таблицей: диапазон дат, инструменты и направление
	   действуют одновременно и меняют только представление списка — разбор
	   выбранных работает как раньше. Пустое поле даты снимает ограничение
	   с соответствующей стороны диапазона. Область обособлена рамкой fieldset
	   с заголовком «Фильтры», чтобы не смешиваться с формами разбора выбранных. *@
	@* Traceability: openspec:ui/screens#requirement-inbox-screen *@
	<fieldset class="action-form inbox-filters">
		<legend>Фильтры</legend>
		<label class="action-label">
			с
			<input type="date" class="action-input date-input" value="@DateFromInput" @onchange="OnDateFromChanged" />
		</label>
		<label class="action-label">
			по
			<input type="date" class="action-input date-input" value="@DateToInput" @onchange="OnDateToChanged" />
		</label>
		@* Контрол инструментов: кнопка показывает счётчик выбранного, панель
		   раскрывается кликом — длинный список символов не растягивает строку
		   фильтров и живёт в своей рамке над таблицей. *@
		<div class="symbols-dropdown">
			<button type="button" class="symbols-toggle" @onclick="ToggleSymbolsDropdown">
				Инструменты: @SelectedSymbolsCount из @AvailableSymbolsCount@(_symbolsDropdownOpen ? " ▴" : " ▾")
			</button>
			@if (_symbolsDropdownOpen)
			{
				<div class="symbols-panel">
					@* «Выбрать все» переключает набор инструментов как «все или ничего»:
					   полный набор снимается целиком, неполный — дополняется до всех.
					   Пустой набор скрывает все строки с сообщением о пустом результате. *@
					@* Traceability: openspec:ui/screens#scenario-inbox-filters-symbols-select-all *@
					<label class="action-label symbols-select-all">
						<input type="checkbox" checked="@AllSymbolsSelected" @onchange="ToggleAllSymbols" />
						Выбрать все
					</label>
					<span class="filter-symbols">
						@foreach (var symbol in AvailableSymbols)
						{
							<label class="action-label">
								<input type="checkbox" checked="@_selectedSymbols.Contains(symbol)" @onchange="args => OnSymbolFilterChanged(symbol, args.Value is true)" />
								@symbol
							</label>
						}
					</span>
				</div>
			}
		</div>
		@* Направление — два независимых чекбокса в общей рамке с заголовком:
		   логика не меняется, состояние «оба сняты» остаётся допустимым и даёт
		   пустой список с явным сообщением. *@
		<fieldset class="filter-direction-group">
			<legend>Направление</legend>
			<label class="action-label filter-direction">
				<input type="checkbox" checked="@_filterBuy" @onchange="args => OnDirectionFilterChanged(false, args.Value is true)" />
				покупка
			</label>
			<label class="action-label filter-direction">
				<input type="checkbox" checked="@_filterSell" @onchange="args => OnDirectionFilterChanged(true, args.Value is true)" />
				продажа
			</label>
		</fieldset>
	</fieldset>

	@if (VisibleTrades.Any() == false)
	{
		@* Список непуст, но фильтры скрыли все строки: причина пустого экрана
		   должна отличаться от отсутствия непривязанных сделок. *@
		@* Traceability: change:add-inbox-filters/design#d6 *@
		<p class="note">По заданным фильтрам ничего не найдено: измените диапазон дат, инструменты или направление.</p>
	}
	else
	{
		@* Таблица непривязанных сделок с атрибутами биржевой записи и чекбоксами
		   выбора строк; переключатель в шапке выполняет «Выбрать всё» как «все или
		   ничего». Разбор выбранных — массовая привязка и создание конструкции —
		   выполняется use-case сервисами домена, UI собственных правил не вводит. *@
		@* Traceability: openspec:ui/screens#requirement-inbox-screen *@
		<table>
			<thead>
				<tr>
					<th class="col-check">
						<label class="select-all" title="Выбрать все сделки или снять выбор">
							<input type="checkbox" class="select-all" checked="@AllSelected" @onchange="ToggleSelectAll" />
							Выбрать всё
						</label>
					</th>
					<th>Время</th>
					<th>execId</th>
					<th>Инструмент</th>
					<th>Направление</th>
					<th>Количество</th>
					<th>Цена</th>
					<th>Сумма</th>
					<th>Комиссия</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var trade in VisibleTrades)
				{
					<tr>
						<td><input type="checkbox" checked="@IsSelected(trade.ExecId)" @onchange="args => ToggleRow(trade.ExecId, args.Value is true)" /></td>
						<td>@FormatTime(trade.ExecutedAt)</td>
						<td>@trade.ExecId</td>
						<td>@trade.Symbol</td>
						<td class="@DirectionClass(trade.Quantity)">@DirectionText(trade.Quantity)</td>
						<td>@FormatSigned(trade.Quantity)</td>
						<td>@FormatAmount(trade.Price)</td>
						<td>@FormatAmount(AmountOf(trade))</td>
						<td>@FormatFee(trade.Fee, trade.FeeCurrency)</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

@code {
	private IReadOnlyList<MaterializedTrade>? _trades;
	private bool _unavailable;

	// Выбор строк живёт в circuit-состоянии компонента: персистентность не
	// требуется, потерянный при обрыве circuit выбор данных не теряет.
	private readonly HashSet<string> _selectedExecIds = new(StringComparer.Ordinal);

	// Фильтры списка — тоже circuit-состояние представления: контракт
	// read-модели не расширяется, фильтрация выполняется при отрисовке.
	// Traceability: change:add-inbox-filters/design#d1
	private DateOnly? _filterDateFrom;
	private DateOnly? _filterDateTo;
	private readonly HashSet<string> _selectedSymbols = new(StringComparer.Ordinal);
	private bool _filterBuy = true;
	private bool _filterSell = true;

	// Раскрытость панели контрола инструментов — тоже circuit-состояние:
	// панель закрывается повторным кликом по кнопке, JS-интероп для закрытия
	// по клику вне панели не вводится.
	// Traceability: change:add-inbox-filters/design#d8
	private bool _symbolsDropdownOpen;

	protected override async Task OnInitializedAsync()
	{
		// По умолчанию выбраны: скользящий последний месяц — «с» = сегодня − 1
		// месяц, «по» = сегодня по текущим суткам сервера, — все инструменты
		// (пополняются в RefreshAsync) и оба направления.
		// Traceability: openspec:ui/screens#scenario-inbox-filters-default-last-month
		var today = DateOnly.FromDateTime(DateTime.Now);
		_filterDateFrom = today.AddMonths(-1);
		_filterDateTo = today;
		await RefreshAsync();
	}

	/// <summary>
	/// Перечитывает непривязанные сделки из read-модели «Входящих» при открытии
	/// экрана: устаревших значений UI не показывает, а выбор чистит от сделок,
	/// покинувших список; множество инструментов фильтра пересобирается из
	/// текущего списка.
	/// </summary>
	// Экран перечитывает read-модель при каждом открытии; выбор — circuit-состояние.
	// Traceability: change:add-ui-screens/design#d7
	private async Task RefreshAsync()
	{
		try
		{
			_trades = await InboxModel.ListAsync();
			_unavailable = false;
		}
		catch (Exception)
		{
			_trades = null;
			_unavailable = true;
		}

		// Выбор сделок, которых больше нет во «Входящих», теряет смысл.
		_selectedExecIds.RemoveWhere(execId => _trades?.Any(trade => trade.ExecId == execId) == false);

		// Инструменты фильтра пересобираются из текущего списка: новые символы
		// попадают в выбор (по умолчанию выбраны все), исчезнувшие из списка
		// уходят — инвариант «выбраны все» держится и после синхронизации.
		// Traceability: change:add-inbox-filters/design#d4
		_selectedSymbols.Clear();
		if (_trades is not null)
		{
			foreach (var symbol in _trades.Select(trade => trade.Symbol).Distinct(StringComparer.Ordinal))
			{
				_selectedSymbols.Add(symbol);
			}
		}
	}

	/// <summary>Отмечены ли все видимые (отфильтрованные) сделки — состояние переключателя «Выбрать всё».</summary>
	// Выбор никогда не шире видимых строк: скрытая фильтром сделка исключается
	// из выбора, поэтому достаточно сравнить количества.
	// Traceability: openspec:ui/screens#scenario-inbox-select-all-or-none
	private bool AllSelected
	{
		get
		{
			var visibleCount = VisibleTrades.Count();
			return visibleCount > 0 && _selectedExecIds.Count == visibleCount;
		}
	}

	/// <summary>Выбрана ли сделка строки по её execId.</summary>
	private bool IsSelected(string execId) => _selectedExecIds.Contains(execId);

	/// <summary>
	/// Переключатель «Выбрать всё» работает как «все или ничего» по видимым
	/// (отфильтрованным) сделкам: когда выбраны все видимые, нажатие снимает
	/// выбор полностью, иначе выбираются все видимые сделки — скрытые
	/// фильтрами сделки в выбор не попадают.
	/// </summary>
	// Traceability: openspec:ui/screens#scenario-inbox-select-all-or-none
	private void ToggleSelectAll(ChangeEventArgs args)
	{
		if (AllSelected)
		{
			_selectedExecIds.Clear();
			return;
		}

		foreach (var trade in VisibleTrades)
		{
			_selectedExecIds.Add(trade.ExecId);
		}
	}

	/// <summary>Чекбокс строки выбирает или снимает одну сделку по её execId.</summary>
	// Traceability: openspec:ui/screens#requirement-inbox-screen
	private void ToggleRow(string execId, bool selected)
	{
		if (selected)
		{
			_selectedExecIds.Add(execId);
		}
		else
		{
			_selectedExecIds.Remove(execId);
		}
	}

	#region Фильтры списка

	/// <summary>Видимые (отфильтрованные) сделки — то, что показывает таблица и что выбирает «Выбрать всё».</summary>
	// Traceability: openspec:ui/screens#requirement-inbox-screen
	private IEnumerable<MaterializedTrade> VisibleTrades =>
		_trades?.Where(IsVisible) ?? Enumerable.Empty<MaterializedTrade>();

	/// <summary>Проходит ли сделка через все фильтры одновременно: диапазон дат, инструмент и направление.</summary>
	// Сравнение дат включительное, очищенная граница снимает ограничение с
	// соответствующей стороны; направление определяется знаком количества.
	// Traceability: openspec:ui/screens#scenario-inbox-filters-combine
	private bool IsVisible(MaterializedTrade trade)
	{
		if (_filterDateFrom is { } from && ExecutionDateOf(trade) < from)
		{
			return false;
		}

		if (_filterDateTo is { } to && ExecutionDateOf(trade) > to)
		{
			return false;
		}

		if (_filterBuy == false && trade.Quantity > 0)
		{
			return false;
		}

		if (_filterSell == false && trade.Quantity < 0)
		{
			return false;
		}

		return _selectedSymbols.Contains(trade.Symbol);
	}

	/// <summary>Календарные сутки исполнения по часам сервера — гранулярность фильтра дат.</summary>
	private static DateOnly ExecutionDateOf(MaterializedTrade trade) =>
		DateOnly.FromDateTime(trade.ExecutedAt.LocalDateTime);

	/// <summary>Упорядоченный уникальный список инструментов текущих «Входящих» — пункты фильтра инструментов.</summary>
	private IEnumerable<string> AvailableSymbols =>
		(_trades ?? Enumerable.Empty<MaterializedTrade>())
			.Select(trade => trade.Symbol)
			.Distinct(StringComparer.Ordinal)
			.OrderBy(symbol => symbol, StringComparer.Ordinal);

	/// <summary>Поле «с»: пустое значение снимает ограничение с начала диапазона.</summary>
	private string DateFromInput => DateFilterText(_filterDateFrom);

	/// <summary>Поле «по»: пустое значение снимает ограничение с конца диапазона.</summary>
	private string DateToInput => DateFilterText(_filterDateTo);

	/// <summary>Смена границы «с»: пустое поле открывает диапазон слева.</summary>
	// Traceability: openspec:ui/screens#requirement-inbox-screen
	private void OnDateFromChanged(ChangeEventArgs args)
	{
		_filterDateFrom = ParseDateFilter(args.Value as string);
		OnFiltersChanged();
	}

	/// <summary>Смена границы «по»: пустое поле открывает диапазон справа.</summary>
	// Traceability: openspec:ui/screens#requirement-inbox-screen
	private void OnDateToChanged(ChangeEventArgs args)
	{
		_filterDateTo = ParseDateFilter(args.Value as string);
		OnFiltersChanged();
	}

	/// <summary>Текст поля даты для ввода: формат input type="date" либо пустая строка.</summary>
	private static string DateFilterText(DateOnly? date) =>
		date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty;

	/// <summary>Разбор поля даты: пустое или неразбираемое значение снимает границу диапазона.</summary>
	private static DateOnly? ParseDateFilter(string? text) =>
		DateOnly.TryParse(text, CultureInfo.InvariantCulture, DateTimeStyles.None, out var date) ? date : null;

	/// <summary>Чекбокс инструмента включает или исключает символ из видимых сделок.</summary>
	// Traceability: openspec:ui/screens#requirement-inbox-screen
	private void OnSymbolFilterChanged(string symbol, bool selected)
	{
		if (selected)
		{
			_selectedSymbols.Add(symbol);
		}
		else
		{
			_selectedSymbols.Remove(symbol);
		}

		OnFiltersChanged();
	}

	/// <summary>Число выбранных инструментов — счётчик на кнопке контрола.</summary>
	private int SelectedSymbolsCount => _selectedSymbols.Count;

	/// <summary>Число всех доступных инструментов — счётчик на кнопке контрола.</summary>
	private int AvailableSymbolsCount => AvailableSymbols.Count();

	/// <summary>Отмечены ли все доступные инструменты — состояние чекбокса «Выбрать все».</summary>
	private bool AllSymbolsSelected =>
		AvailableSymbols.Any() && AvailableSymbols.All(symbol => _selectedSymbols.Contains(symbol));

	/// <summary>Кнопка контрола инструментов раскрывает панель и закрывает повторным кликом.</summary>
	// Traceability: change:add-inbox-filters/design#d8
	private void ToggleSymbolsDropdown() => _symbolsDropdownOpen = _symbolsDropdownOpen == false;

	/// <summary>
	/// «Выбрать все» в контроле инструментов работает как «все или ничего»:
	/// полностью выбранный набор снимается целиком, неполный — дополняется
	/// до всех; пустой набор скрывает все строки с сообщением о пустом
	/// результате фильтров.
	/// </summary>
	// Traceability: openspec:ui/screens#scenario-inbox-filters-symbols-select-all
	private void ToggleAllSymbols(ChangeEventArgs args)
	{
		var wasAllSelected = AllSymbolsSelected;
		_selectedSymbols.Clear();
		if (wasAllSelected == false)
		{
			_selectedSymbols.UnionWith(AvailableSymbols);
		}

		OnFiltersChanged();
	}

	/// <summary>Флажок направления: «покупка» — положительное количество, «продажа» — отрицательное.</summary>
	// Снятие обоих флажков даёт пустой видимый список с явным сообщением,
	// без скрытой логики «пусто значит все».
	// Traceability: openspec:ui/screens#scenario-inbox-filters-combine
	private void OnDirectionFilterChanged(bool isSell, bool selected)
	{
		if (isSell)
		{
			_filterSell = selected;
		}
		else
		{
			_filterBuy = selected;
		}

		OnFiltersChanged();
	}

	/// <summary>
	/// Исключает скрытые фильтрами сделки из выбора: массовая привязка не
	/// должна забирать строки, которых пользователь на экране не видит.
	/// </summary>
	// Traceability: openspec:ui/screens#requirement-inbox-screen
	private void OnFiltersChanged() =>
		_selectedExecIds.RemoveWhere(execId => VisibleTrades.Any(trade => trade.ExecId == execId) == false);

	#endregion

	#region Разбор выбранных

	// Активные конструкции для формы привязки; null — форма закрыта.
	private List<Construction>? _bindTargets;
	private long? _bindTargetId;
	private bool _createFormOpen;
	private string _createNameInput = string.Empty;
	private string _createCapitalInput = string.Empty;
	private bool _createNameInvalid;
	private bool _createCapitalInvalid;
	private string? _actionError;
	private bool _busy;

	/// <summary>Выбрана ли хотя бы одна сделка — доступность команд разбора.</summary>
	private bool HasNoSelection => _selectedExecIds.Count == 0;

	/// <summary>
	/// Открывает форму массовой привязки: читает активные конструкции и
	/// подставляет первую целевым выбором по умолчанию; форма создания
	/// закрывается — одновременно открыта одна форма разбора.
	/// </summary>
	// Целевая привязка предлагается только среди активных конструкций: архив
	// скрыт из списков, привязывать в него нельзя.
	// Traceability: openspec:ui/screens#scenario-inbox-batch-bind-clears
	private async Task BeginBindAsync()
	{
		if (_busy || HasNoSelection)
		{
			return;
		}

		try
		{
			_bindTargets = [.. await Constructions.ListActiveAsync()];
			_bindTargetId = _bindTargets.Count > 0 ? _bindTargets[0].Id : null;
			_createFormOpen = false;
			_actionError = null;
		}
		catch (Exception ex)
		{
			// Список кандидатов недоступен — форма не открывается, причина видна
			// пользователю вместо пустого выбора.
			_actionError = $"Список конструкций недоступен: {ex.Message}";
		}
	}

	/// <summary>Закрывает форму привязки без изменения принадлежности сделок.</summary>
	private void CancelBind()
	{
		_bindTargets = null;
		_bindTargetId = null;
		_actionError = null;
	}

	/// <summary>
	/// Привязывает все выбранные сделки к выбранной конструкции: сделки исчезают
	/// из «Входящих» и принадлежат ровно этой конструкции, выбор строк очищается,
	/// бейдж вкладки уменьшается по сигналу каркасу.
	/// </summary>
	// Массовая привязка атомарна в домене: отказ на любой сделке откатывает
	// всю пачку, форма остаётся открытой с причиной.
	// Traceability: openspec:ui/screens#scenario-inbox-batch-bind-clears
	private Task ConfirmBindAsync()
	{
		if (_busy || _bindTargetId is not { } targetId)
		{
			return Task.CompletedTask;
		}

		return RunBindingActionAsync(
			() => Bindings.BindBatchAsync(targetId, _selectedExecIds),
			"Привязка не выполнена",
			CancelBind);
	}

	/// <summary>
	/// Открывает форму создания конструкции из выбранных с пустыми полями имени
	/// и капитала; форма привязки закрывается.
	/// </summary>
	// Traceability: openspec:ui/screens#scenario-inbox-create-construction-from-selected
	private void BeginCreateAsync()
	{
		if (_busy || HasNoSelection)
		{
			return;
		}

		_createFormOpen = true;
		_createNameInput = string.Empty;
		_createCapitalInput = string.Empty;
		_createNameInvalid = false;
		_createCapitalInvalid = false;
		_bindTargets = null;
		_bindTargetId = null;
		_actionError = null;
	}

	/// <summary>Закрывает форму создания без создания конструкции и привязки.</summary>
	private void CancelCreate()
	{
		_createFormOpen = false;
		_createNameInvalid = false;
		_createCapitalInvalid = false;
		_actionError = null;
	}

	/// <summary>
	/// Создаёт конструкцию из выбранных сделок: имя и капитал разбираются из
	/// формы, конструкция создаётся со статусом «открыта» и забирает все
	/// выбранные сделки одним атомарным действием.
	/// </summary>
	// Создание идёт use-case сервисом домена: стартовый статус «открыта»
	// фиксирован доменом, UI собственных правил не вводит.
	// Traceability: openspec:ui/screens#scenario-inbox-create-construction-from-selected
	private Task ConfirmCreateAsync()
	{
		if (_busy || HasNoSelection)
		{
			return Task.CompletedTask;
		}

		if (string.IsNullOrWhiteSpace(_createNameInput))
		{
			_createNameInvalid = true;
			return Task.CompletedTask;
		}

		// Капитал необязателен: пустое поле создаёт конструкцию без выделенного
		// бюджета, непустое должно быть числом в USDT — проверка числа работает
		// только при непустом вводе.
		// Traceability: openspec:ui/screens#scenario-inbox-create-without-capital
		decimal? capital = null;
		if (string.IsNullOrWhiteSpace(_createCapitalInput) == false)
		{
			if (decimal.TryParse(_createCapitalInput, NumberStyles.Number, CultureInfo.InvariantCulture, out var parsedCapital) == false)
			{
				_createCapitalInvalid = true;
				return Task.CompletedTask;
			}

			capital = parsedCapital;
		}

		_createNameInvalid = false;
		_createCapitalInvalid = false;
		var name = _createNameInput.Trim();

		return RunBindingActionAsync(
			async () =>
			{
				var created = await Constructions.CreateAsync(name, capital);
				await Bindings.BindBatchAsync(created.Id, _selectedExecIds);
			},
			"Создание конструкции не выполнено",
			CancelCreate);
	}

	/// <summary>
	/// Выполняет команду разбора выбранных: успех закрывает форму, очищает выбор,
	/// перечитывает «Входящие» и оповещает каркас — бейдж вкладки уменьшается;
	/// отказ домена оставляет форму открытой с причиной, выбор не трогается.
	/// </summary>
	// Traceability: openspec:ui/screens#requirement-inbox-screen
	private async Task RunBindingActionAsync(Func<Task> action, string errorPrefix, Action closeForm)
	{
		_busy = true;
		try
		{
			await action();
		}
		catch (Exception ex)
		{
			_busy = false;
			_actionError = $"{errorPrefix}: {ex.Message}";
			return;
		}

		_busy = false;
		closeForm();

		// После действия выбор очищается, даже если часть выбранных сделок по
		// какой-то причине осталась в списке — команда разбора завершена целиком.
		// Traceability: openspec:ui/screens#requirement-inbox-screen
		_selectedExecIds.Clear();
		await RefreshAsync();

		// Сделки покинули «Входящие»: каркас по сигналу перечитывает панель и
		// уменьшает бейдж вкладки без навигации.
		// Traceability: openspec:ui/screens#scenario-inbox-badge-counts-unassigned
		await Changes.RaiseAsync();
	}

	#endregion

	#region Форматирование

	/// <summary>Время исполнения: «2026-06-20 14:30» в локальном времени.</summary>
	// Даты сделок приходят из синхронизации в UTC и показываются в локальной зоне.
	// Traceability: openspec:ui/screens#scenario-sync-dates-shown-local
	private static string FormatTime(DateTimeOffset moment) =>
		DisplayTime.FormatMoment(moment);

	/// <summary>Направление по знаку количества: покупка положительна, продажа отрицательна.</summary>
	private static string DirectionText(decimal quantity) => quantity > 0 ? "покупка" : "продажа";

	/// <summary>Класс направления: покупка зелёным, продажа красным.</summary>
	private static string DirectionClass(decimal quantity) => quantity > 0 ? "pos" : "neg";

	/// <summary>Сумма сделки без направления: произведение модуля количества на цену.</summary>
	private static decimal AmountOf(MaterializedTrade trade) => Math.Abs(trade.Quantity) * trade.Price;

	/// <summary>Знаковый формат количества и комиссии: «+0.01» / «-0.0001» / «0».</summary>
	private static string FormatSigned(decimal value) =>
		value.ToString("+0.####;-0.####;0", CultureInfo.InvariantCulture);

	/// <summary>Беззнаковый формат цены и суммы: «45000» / «4.5».</summary>
	private static string FormatAmount(decimal value) =>
		value.ToString("0.########", CultureInfo.InvariantCulture);

	/// <summary>Комиссия со знаком и валютой биржи: «+0.01 USDT» / «-0.0001 BTC»; без валюты — только число.</summary>
	private static string FormatFee(decimal fee, string? feeCurrency) => feeCurrency is null
		? FormatSigned(fee)
		: $"{FormatSigned(fee)} {feeCurrency}";

	#endregion
}
