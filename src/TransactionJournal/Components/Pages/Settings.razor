@page "/settings"

@rendermode InteractiveServer

@using System.Globalization
@using TransactionJournal.Bybit
@using TransactionJournal.Components.Layout
@using TransactionJournal.Data
@using TransactionJournal.Domain.ConstructionAssembly
@using TransactionJournal.Materialization
@using TransactionJournal.Sync
@inject SettingsReadModel Connection
@inject IJournalSyncService SyncService
@inject ISyncJournalReadModel SyncJournal
@inject IJournalReparseService Reparse
@inject IConstructionAssemblyService Assembly
@inject JournalChangeSignal Changes

<PageTitle>Настройки — Журнал Bybit</PageTitle>

<h1>Настройки</h1>

<h2>Подключение</h2>

@if (_connection is null)
{
	@* Ключ не настроен: вместо маски — явное состояние с указанием переменных
	   окружения, где пользователь задаёт ключ и секрет. *@
	@* Traceability: openspec:ui/screens#scenario-settings-secret-never-displayed *@
	<p class="note">
		Ключ не настроен: задайте переменные окружения
		@EnvironmentBybitCredentialsProvider.ApiKeyVariableName и
		@EnvironmentBybitCredentialsProvider.ApiSecretVariableName и перезапустите журнал.
	</p>
}
else
{
	@* Блок подключения: ключ маскирован, секрет интерфейсу не передаётся и не
	   вводится через экран — место его хранения только переменные окружения. *@
	@* Traceability: openspec:ui/screens#scenario-settings-secret-never-displayed *@
	<div class="kv">
		<div class="k">API-ключ (read-only)</div>
		<div class="v">@_connection.MaskedApiKey</div>
		<div class="k">Аккаунт</div>
		<div class="v plain">@_connection.AccountDescription</div>
		<div class="k">Секрет</div>
		<div class="v plain">@_connection.SecretStorage</div>
	</div>
}

<h2>Синхронизация</h2>

@* Единственная кнопка синхронизации на «Настройках»: режим выбирает система сама —
   backfill при первом запуске, инкремент далее — и виден строкой журнала ниже;
   селект режима из прототипа не реализуется. *@
@* Traceability: openspec:ui/screens#requirement-settings-screen *@
@* Traceability: change:add-ui-screens/design#d3 *@
<div class="toolbar">
	<button type="button" class="btn" disabled="@_syncRunning" @onclick="RunSyncAsync">Синхронизировать сейчас</button>
</div>

@if (_syncRunning)
{
	<p class="note" role="status">Синхронизация выполняется…</p>
}
else if (_syncError is not null)
{
	@* Ошибка биржи не оставляет журнал несогласованным: прерванный запуск остался
	   строкой журнала со статусом и причиной, повторный запуск продолжит без дублей. *@
	<p class="note note-error" role="alert"><b>Синхронизация прервана:</b> @_syncError</p>
}

@* Журнал синхронизаций: строка на запуск — время, выбранный системой режим,
   результат и статус. Предупреждения сверки показываются под журналом для
   последнего завершившегося запуска и работу не блокируют. *@
@* Traceability: openspec:ui/screens#scenario-settings-sync-log-mode-warnings *@
@if (_journalUnavailable)
{
	@* Явное состояние вместо пустого экрана: журнал не прочитан — пользователь
	   видит причину, повторное чтение произойдёт при следующем открытии экрана. *@
	<p class="note note-error" role="alert">Журнал синхронизаций недоступен: не удалось прочитать запуски. Обновите экран.</p>
}
else if (_journal.Count == 0)
{
	<p class="note">Синхронизаций ещё не было: нажмите «Синхронизировать сейчас».</p>
}
else
{
	<table>
		<thead>
			<tr>
				<th>Время</th>
				<th>Режим</th>
				<th>Результат</th>
				<th>Статус</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var run in _journal)
			{
				<tr>
					<td>@FormatDate(run.StartedAt)</td>
					<td>@ModeLabel(run.Mode)</td>
					<td>@ResultLabel(run)</td>
					<td>@StatusText(run.Status)</td>
				</tr>
			}
		</tbody>
	</table>
}

@if (_syncResult is not null)
{
	@if (_syncResult.ProjectionError is not null)
	{
		@* Сырые записи синхронизация сохранила, проекция не построилась — причина
		   видна, работа журнала продолжается. *@
		<div role="alert">
			<strong>Проекция журнала не построена:</strong> @_syncResult.ProjectionError
		</div>
	}
	else if (_syncResult.Projection is { } projection)
	{
		@if (projection.ReconciliationWarnings.Count == 0)
		{
			<p class="note note-ok" role="status">Предупреждений сверки с биржей у последнего запуска нет.</p>
		}
		else
		{
			@* Предупреждение сверки не блокирует работу: собственный расчёт журнала
			   остаётся источником результата, биржевая величина — только сигнал. *@
			@* Traceability: openspec:sync/bybit-history#scenario-delivery-reconciliation-warning *@
			<p class="note">Предупреждения сверки с биржей — последний запуск:</p>
			<ul>
				@foreach (var warning in projection.ReconciliationWarnings)
				{
					<li>
						@warning.Symbol
						(@DisplayTime.FormatMoment(warning.DeliveryTime)):
						расхождение @warning.Difference.ToString("0.0###", CultureInfo.InvariantCulture)
					</li>
				}
			</ul>
		}
	}
}

<h2>Опасная зона</h2>

@* Переразбор сырых записей — опасное действие: доменные представления журнала
   перестраиваются из сырья заново. Команда запускается только после явного
   подтверждения — первое нажатие кнопки лишь показывает вопрос, без
   подтверждения переразбор не начинается. *@
@* Traceability: openspec:ui/screens#scenario-settings-reparse-confirmation *@
@if (_reparseConfirming == false)
{
	<div class="toolbar">
		<button type="button" class="btn danger" disabled="@_reparseRunning" @onclick="BeginReparse">Переразобрать сырые записи заново</button>
	</div>
}
else
{
	@* Подтверждение — отдельный шаг с объяснением последствий и выходом
	   «Отмена»: отмена закрывает вопрос, ничего не запуская. *@
	<div class="action-form">
		<span class="action-warning">Переразобрать сырые записи журнала заново? Доменные представления будут перестроены из сырья.</span>
		<button type="button" class="btn danger" disabled="@_reparseRunning" @onclick="RunReparseAsync">Переразобрать</button>
		<button type="button" class="btn" disabled="@_reparseRunning" @onclick="CancelReparse">Отмена</button>
	</div>
}

@if (_reparseRunning)
{
	<p class="note" role="status">Переразбор выполняется…</p>
}
else if (_reparseError is not null)
{
	@* Повреждённое сырьё доходит причиной: прежние проекции read-моделей
	   продолжают показываться, повторная попытка доступна кнопкой. *@
	<p class="note note-error" role="alert"><b>Переразбор не выполнен:</b> @_reparseError</p>
}
else if (_reparseResult is not null)
{
	@* Итог пересборки: счётчики доменных представлений и предупреждения сверки
	   из локального сырья — подтверждение, что сырьё разбирается без ошибок. *@
	<p class="note note-ok" role="status">
		Переразбор завершён: сделок во «Входящих» @_reparseResult.InboxTrades.Count · закрывающих записей @_reparseResult.ExpiryClosingEntries.Count · предупреждений сверки @_reparseResult.ReconciliationWarnings.Count
	</p>
}

@* Сборка конструкций — две отдельные команды (ADR-0004). «Собрать из „Входящих”»
   безопасна: обрабатывает только нераспределённые записи, читая существующие
   конструкции как контекст, поэтому запускается сразу, без подтверждения.
   «Собрать конструкции» — аварийный полный пересбор: стирает конструкции вместе
   с привязками, капиталом и ручными данными, поэтому запускается только после
   явного подтверждения с перечнем безвозвратных потерь; первое нажатие кнопки
   лишь показывает вопрос, без подтверждения пересбор не начинается. *@
@* Требование: инкрементная сборка запускается без подтверждения, пересбор — только после него. *@
@* Traceability: change:refine-construction-assembly/specs/ui/screens/spec#scenario-inbox-assembly-without-confirmation *@
@* Traceability: change:refine-construction-assembly/specs/ui/screens/spec#scenario-assembly-requires-confirmation *@
<div class="toolbar">
	<button type="button" class="btn" disabled="@_assemblyRunning" @onclick="RunInboxAssemblyAsync">Собрать из „Входящих”</button>
	<button type="button" class="btn danger" disabled="@_assemblyRunning" @onclick="BeginAssembly">Собрать конструкции</button>
</div>
@if (_assemblyConfirming)
{
	@* Подтверждение перечисляет безвозвратные потери целиком и сообщает, что
	   перед пересбором автоматически создаётся резервная копия базы журнала:
	   неудача копии блокирует пересбор и доходит причиной до пользователя.
	   «Отмена» закрывает вопрос, ничего не запуская. *@
	@* Traceability: openspec:ui/screens#scenario-assembly-confirmation-mentions-backup *@
	<div class="action-form">
		<span class="action-warning">
			Собрать конструкции заново? Безвозвратно удаляются: все конструкции, привязки сделок,
			выделенный капитал, риск и профит, комментарии конструкций, позиций и сделок,
			внешние корректировки PnL и ручные пометки закрытия.
			Перед пересбором автоматически создаётся резервная копия базы журнала.
		</span>
		<button type="button" class="btn danger" disabled="@_assemblyRunning" @onclick="RunAssemblyAsync">Собрать</button>
		<button type="button" class="btn" disabled="@_assemblyRunning" @onclick="CancelAssembly">Отмена</button>
	</div>
}

@if (_assemblyRunning)
{
	<p class="note" role="status">Сборка конструкций выполняется…</p>
}
else if (_assemblyError is not null)
{
	@* Ошибка сборки не портит сырьё: причина доходит до пользователя текстом,
	   повторная попытка доступна кнопкой после её закрытия. *@
	<p class="note note-error" role="alert"><b>Сборка конструкций не выполнена:</b> @_assemblyError</p>
}
else if (_assemblyResult is not null)
{
	@* Итог любой из команд сборки: счётчики плана сборки — созданные конструкции,
	   привязанные сделки и оставшиеся во «Входящих»; сами списки и бейдж «Входящих»
	   каркас перечитывает по сигналу без дополнительных действий пользователя. *@
	@* Требование: после завершения каждой команды сборки пользователь видит счётчики итога. *@
	@* Traceability: change:refine-construction-assembly/specs/ui/screens/spec#scenario-assembly-shows-result *@
	<p class="note note-ok" role="status">
		Сборка завершена: конструкций @_assemblyResult.ConstructionsCount · привязано сделок @_assemblyResult.BoundCount · во «Входящих» @_assemblyResult.TradesInInbox
	</p>
}

@code {
	private ConnectionInfo? _connection;
	private IReadOnlyList<SyncRunRow> _journal = [];
	private bool _journalUnavailable;
	private bool _syncRunning;
	private JournalSyncResult? _syncResult;
	private string? _syncError;
	private bool _reparseConfirming;
	private bool _reparseRunning;
	private JournalMaterializationResult? _reparseResult;
	private string? _reparseError;
	private bool _assemblyConfirming;
	private bool _assemblyRunning;
	private ConstructionRebuildResult? _assemblyResult;
	private string? _assemblyError;

	protected override async Task OnInitializedAsync()
	{
		_connection = Connection.GetConnection();
		await RefreshJournalAsync();
	}

	/// <summary>
	/// Выполняет единственную ручную команду синхронизации: запуск идёт до конца,
	/// кнопка блокируется на время работы; после завершения журнал перечитывается —
	/// новая строка со временем, режимом, результатом и статусом появляется в
	/// журнале, предупреждения сверки показываются рядом, не блокируя работу.
	/// </summary>
	// Сценарий журнала: после завершения синка строка появляется в журнале,
	// а предупреждения сверки видны и работу не блокируют.
	// Traceability: openspec:ui/screens#scenario-settings-sync-log-mode-warnings
	private async Task RunSyncAsync()
	{
		_syncRunning = true;
		_syncResult = null;
		_syncError = null;

		try
		{
			_syncResult = await SyncService.SyncAsync();
		}
		catch (Exception ex)
		{
			// Ошибка биржи после всех повторов доходит до пользователя текстом —
			// прерванный запуск остался строкой журнала со статусом «ошибка».
			_syncError = ex.Message;
		}
		finally
		{
			_syncRunning = false;
		}

		await RefreshJournalAsync();
	}

	/// <summary>Перечитывает журнал синхронизаций из хранилища; сбой чтения — явное состояние.</summary>
	private async Task RefreshJournalAsync()
	{
		try
		{
			_journal = await SyncJournal.ReadAsync();
			_journalUnavailable = false;
		}
		catch (Exception)
		{
			_journal = [];
			_journalUnavailable = true;
		}
	}

	/// <summary>
	/// Открывает подтверждение опасного действия: переразбор запускается только
	/// явным подтверждением — первое нажатие кнопки лишь показывает вопрос.
	/// </summary>
	// Требование: переразбор требует подтверждения опасного действия.
	// Traceability: openspec:ui/screens#scenario-settings-reparse-confirmation
	private void BeginReparse()
	{
		_reparseConfirming = true;
		_reparseResult = null;
		_reparseError = null;
	}

	/// <summary>Закрывает подтверждение без запуска: переразбор не начинается.</summary>
	private void CancelReparse() => _reparseConfirming = false;

	/// <summary>
	/// Выполняет переразбор после подтверждения: сырые записи читаются целиком и
	/// доменные представления строятся заново без сетевых запросов; итог со
	/// счётчиками и предупреждениями сверки показывается под командой, каркас
	/// оповещается о пересборке производных представлений.
	/// </summary>
	private async Task RunReparseAsync()
	{
		_reparseRunning = true;

		try
		{
			_reparseResult = await Reparse.ReparseAsync();
			_reparseError = null;
		}
		catch (Exception ex)
		{
			// Ошибка разбора доходит причиной: сырьё сохранилось, проекции
			// read-моделей продолжают строиться, повторная попытка доступна.
			_reparseError = ex.Message;
			_reparseResult = null;
		}
		finally
		{
			_reparseRunning = false;
			_reparseConfirming = false;
		}

		// Пересборка меняет производные представления: каркас перечитывает итог
		// панели и бейдж «Входящих» без навигации.
		await Changes.RaiseAsync();
	}

	/// <summary>
	/// Открывает подтверждение сборки конструкций: полный пересбор стирает доменные
	/// таблицы, поэтому запускается только явным подтверждением — первое нажатие
	/// кнопки лишь показывает вопрос с перечнем безвозвратных потерь.
	/// </summary>
	// Требование: пересбор требует подтверждения опасного действия.
	// Traceability: change:refine-construction-assembly/specs/ui/screens/spec#scenario-assembly-requires-confirmation
	private void BeginAssembly()
	{
		_assemblyConfirming = true;
		_assemblyResult = null;
		_assemblyError = null;
	}

	/// <summary>Закрывает подтверждение без запуска: сборка не начинается.</summary>
	private void CancelAssembly() => _assemblyConfirming = false;

	/// <summary>
	/// Выполняет сборку из «Входящих» сразу, без подтверждения: сервис
	/// обрабатывает только нераспределённые записи, читая существующие
	/// конструкции как контекст остатков, — ручные данные не затрагиваются; итог
	/// со счётчиками показывается под командой, каркас оповещается о пересборке
	/// производных представлений — список конструкций и бейдж «Входящих»
	/// обновляются сами.
	/// </summary>
	// Требование: инкрементная сборка безопасна и запускается одним нажатием.
	// Traceability: change:refine-construction-assembly/specs/ui/screens/spec#scenario-inbox-assembly-without-confirmation
	private async Task RunInboxAssemblyAsync()
	{
		_assemblyRunning = true;

		try
		{
			_assemblyResult = await Assembly.AssembleInboxAsync();
			_assemblyError = null;
		}
		catch (Exception ex)
		{
			// Ошибка сборки доходит причиной: сырьё и привязки сохранились,
			// повторная попытка доступна кнопкой.
			_assemblyError = ex.Message;
			_assemblyResult = null;
		}
		finally
		{
			_assemblyRunning = false;
		}

		// Сборка меняет конструкции и привязки: каркас перечитывает список
		// конструкций и бейдж «Входящих» без навигации.
		await Changes.RaiseAsync();
	}

	/// <summary>
	/// Выполняет полный пересбор после подтверждения: сервис стирает доменные
	/// таблицы и собирает конструкции и привязки из локального сырья одной
	/// транзакцией; итог со счётчиками показывается под командой, каркас
	/// оповещается о пересборке производных представлений — список конструкций
	/// и бейдж «Входящих» обновляются сами.
	/// </summary>
	// Требование: итог сборки виден пользователю, результат отражается в бейдже «Входящих».
	// Traceability: change:refine-construction-assembly/specs/ui/screens/spec#scenario-assembly-shows-result
	private async Task RunAssemblyAsync()
	{
		_assemblyRunning = true;

		try
		{
			_assemblyResult = await Assembly.RebuildAsync();
			_assemblyError = null;
		}
		catch (Exception ex)
		{
			// Ошибка пересбора доходит причиной: сырьё сохранилось, повторная
			// попытка доступна кнопкой.
			_assemblyError = ex.Message;
			_assemblyResult = null;
		}
		finally
		{
			_assemblyRunning = false;
			_assemblyConfirming = false;
		}

		// Сборка меняет конструкции и привязки: каркас перечитывает список
		// конструкций и бейдж «Входящих» без навигации.
		await Changes.RaiseAsync();
	}

	/// <summary>Дата-время запуска: «2026-01-01 14:30» в локальном времени.</summary>
	// Даты запусков синхронизации приходят из журнала в UTC и показываются в локальной зоне.
	// Traceability: openspec:ui/screens#scenario-sync-dates-shown-local
	private static string FormatDate(DateTimeOffset moment) =>
		DisplayTime.FormatMoment(moment);

	/// <summary>Название режима запуска, выбранного системой: backfill при первом запуске, далее инкремент.</summary>
	private static string ModeLabel(SyncRunMode mode) => mode == SyncRunMode.Backfill
		? "первичная загрузка (backfill)"
		: "инкрементальная догрузка";

	/// <summary>Результат запуска: счётчики новых записей у успешного, причина у прерванного, прогресс у идущего.</summary>
	private static string ResultLabel(SyncRunRow run) => run.Status switch
	{
		SyncRunStatus.Running => "выполняется…",
		SyncRunStatus.Failed => $"прерван: {run.Error}",
		_ => $"исполнений {run.NewExecutions} · delivery {run.NewDeliveries} · инструментов {run.NewInstruments}",
	};

	/// <summary>Статус запуска словами: выполняется / успех / ошибка.</summary>
	private static string StatusText(SyncRunStatus status) => status switch
	{
		SyncRunStatus.Running => "выполняется",
		SyncRunStatus.Succeeded => "успех",
		_ => "ошибка",
	};
}
