@namespace TransactionJournal.Components
@using System.Text
@using Microsoft.Extensions.AI
@using Microsoft.Extensions.DependencyInjection
@using TransactionJournal.Consultations
@using TransactionJournal.Consultations.Ports
@inject IConsultationStore Store
@inject IServiceProvider Services

@* Панель «Консультации» конструкции: диалоги «один вопрос — один диалог»,
   новый диалог создаётся первым сообщением, удаление диалога целиком с
   подтверждением. Ответ стримится с троттлингом перерисовок ~150 мс,
   между сегментами текста видны статусные строки tool-вызовов, сами
   tool-call фрагменты не рендерятся, генерация отменяется кнопкой.
   Чат read-only: панель не предлагает записей в журнал и сохранения
   планов — план управления остаётся markdown-текстом ответа. *@
@* Traceability: openspec:ui/screens#requirement-ui-consultation-panel *@
<div class="consultations-panel">
	<h2>Консультации</h2>

	@if (_error is not null)
	{
		<p class="note note-error">@_error</p>
	}

	@if (_cancelNotice is not null)
	{
		@* След отмены — не ошибка: вопрос остался в диалоге, ответ не зафиксирован. *@
		<p class="note consultation-cancel-notice">@_cancelNotice</p>
	}

	@if (IsConstructionClosed)
	{
		@* Закрытая конструкция — тот же конвейер чата, но режим пост-мортема:
		   ассистент ведёт разбор работы над ошибками по финальному состоянию
		   журнала, режим задан снимком контекста и инструкциями агента. *@
		@* Traceability: openspec:ui/screens#scenario-ui-closed-construction-postmortem *@
		<p class="note consultation-postmortem-note">Конструкция закрыта — консультации ведутся в режиме пост-мортема: разбор работы над ошибками по финальному состоянию журнала.</p>
	}

	@if (_dialogues.Count > 0)
	{
		@* Список диалогов конструкции: выбор показывает переписку, удаление
		   стирает диалог со всеми сообщениями без возможности восстановления. *@
		<div class="consultation-dialogues">
			@foreach (var dialogue in _dialogues)
			{
				var dialogueId = dialogue.Id;
				<div class="consultation-dialogue-item @(_selectedDialogueId == dialogueId ? "active" : "")">
					<button type="button" class="btn consultation-dialogue-open" @onclick="() => SelectDialogueAsync(dialogueId)">
						Диалог @dialogueId (@DisplayTime.FormatMoment(dialogue.CreatedAt))
					</button>
					@if (_deleteConfirmDialogueId == dialogueId)
					{
						@* Подтверждение — отдельный шаг: без него команда удаления
						   не запускается, восстановить диалог после удаления нельзя. *@
						<span class="consultation-dialogue-confirm">
							<span class="action-warning">Удалить диалог целиком?</span>
							<button type="button" class="btn danger" @onclick="() => DeleteDialogueAsync(dialogueId)">Удалить</button>
							<button type="button" class="btn" @onclick="CancelDelete">Отмена</button>
						</span>
					}
					else
					{
						<button type="button" class="btn consultation-dialogue-delete" @onclick="() => BeginDelete(dialogueId)">удалить…</button>
					}
				</div>
			}
		</div>
	}
	else
	{
		<p class="note empty-consultations">диалогов нет — задайте первый вопрос</p>
	}

	@if (_selectedDialogueId is { } selectedId)
	{
		@* Переписка выбранного диалога: ассистент видит историю только его, —
		   соседние диалоги изолированы. *@
		<div class="consultation-thread" data-dialogue="@selectedId">
			@foreach (var message in _messages)
			{
				<article class="consultation-message consultation-message-@RoleClass(message.Role)">
					<header>
						<span class="consultation-message-role">@RoleTitle(message.Role)</span>
						<span class="consultation-message-asof">@DisplayTime.FormatMoment(message.AsOf)</span>
					</header>
					<p class="consultation-message-text">@message.Text</p>
				</article>
			}
			@if (_generating)
			{
				@* Ответ в генерации: текстовые сегменты показываются по мере
				   стрима, tool-call фрагменты модели текстом не рендерятся —
				   вместо них между сегментами видны статусные строки вызовов. *@
				@* Traceability: openspec:ui/screens#scenario-ui-streaming-with-tool-status *@
				<article class="consultation-message consultation-message-assistant consultation-message-streaming">
					<header>
						<span class="consultation-message-role">Помощник</span>
						<span class="consultation-message-asof">генерация…</span>
					</header>
					@foreach (var segment in _streamSegments)
					{
						@switch (segment)
						{
							case StreamSegment.Text text:
								<p class="consultation-message-text">@text.Content.ToString()</p>
								break;
							case StreamSegment.ToolStatus status:
								<div class="consultation-tool-status @(status.Completed ? "completed" : "pending")">
									@ToolStatusText(status)
								</div>
								break;
						}
					}
				</article>
			}
		</div>
	}

	<div class="consultation-input">
		<textarea class="cell-input" rows="3" placeholder="@InputPlaceholder"
				  disabled="@_generating" @bind="_input" @bind:event="oninput"></textarea>
		<button type="button" class="btn primary consultation-send" disabled="@_generating" @onclick="SendAsync">Отправить</button>
		@if (_generating)
		{
			@* Отмена генерации: стрим останавливается, панель возвращается в
			   состояние ввода, вопрос остаётся в диалоге без ответа. *@
			@* Traceability: openspec:ui/screens#scenario-ui-cancel-generation *@
			<button type="button" class="btn danger consultation-cancel" @onclick="CancelGeneration">Отмена</button>
		}
		@if (_selectedDialogueId is not null && _generating == false)
		{
			@* Продолжение текущего диалога — по желанию владельца: следующий
			   вопрос без выбранного диалога начинает новый с чистого листа. *@
			<button type="button" class="btn" @onclick="StartNewDialogue">новый вопрос</button>
		}
	</div>
</div>

@code {
	/// <summary>Идентификатор конструкции, в контексте которой ведутся консультации.</summary>
	[Parameter] public long ConstructionId { get; set; }

	/// <summary>Конструкция закрыта — консультации ведутся в режиме пост-мортема.</summary>
	[Parameter] public bool IsConstructionClosed { get; set; }

	/// <summary>Минимальный интервал перерисовок стрима: ~150 мс — SignalR-канал не забивается перерисовкой на каждый чанк.</summary>
	private static readonly TimeSpan RedrawInterval = TimeSpan.FromMilliseconds(150);

	private IReadOnlyList<ConsultationDialogue> _dialogues = [];

	private IReadOnlyList<ConsultationMessage> _messages = [];

	/// <summary>Сегменты стримящегося ответа: текстовые блоки и статусные строки tool-вызовов в порядке поступления.</summary>
	private List<StreamSegment> _streamSegments = [];

	private long? _selectedDialogueId;

	private long? _deleteConfirmDialogueId;

	private string _input = string.Empty;

	private bool _generating;

	private string? _error;

	private string? _cancelNotice;

	private CancellationTokenSource? _generationCts;

	private string InputPlaceholder => _selectedDialogueId is null
		? "первый вопрос нового диалога"
		: "продолжить диалог";

	protected override async Task OnParametersSetAsync() => await RefreshAsync();

	/// <summary>Перечитывает список диалогов конструкции и переписку выбранного.</summary>
	private async Task RefreshAsync()
	{
		try
		{
			_dialogues = await Store.ListDialoguesAsync(ConstructionId);
			_messages = _selectedDialogueId is { } selectedId
				? await Store.ListMessagesAsync(ConstructionId, selectedId)
				: [];
			_error = null;
		}
		catch (Exception)
		{
			_error = "Консультации недоступны: не удалось прочитать хранилище. Обновите экран.";
		}
	}

	/// <summary>Выбирает диалог и показывает его переписку.</summary>
	private async Task SelectDialogueAsync(long dialogueId)
	{
		_selectedDialogueId = dialogueId;
		_deleteConfirmDialogueId = null;
		_cancelNotice = null;
		await RefreshAsync();
	}

	/// <summary>Снимает выбор диалога: следующее сообщение начнёт новый диалог.</summary>
	private void StartNewDialogue()
	{
		_selectedDialogueId = null;
		_messages = [];
		_cancelNotice = null;
	}

	/// <summary>
	/// Отправляет вопрос владельца: сообщение без выбранного диалога создаёт
	/// новый диалог, ответ ассистента стримится с троттлингом перерисовок и
	/// статусными строками tool-вызовов, по завершении стрима ответ фиксируется
	/// в диалоге конвейером консультаций.
	// Traceability: openspec:ui/screens#scenario-ui-dialogue-started-by-message
	/// </summary>
	private async Task SendAsync()
	{
		if (_generating || string.IsNullOrWhiteSpace(_input))
		{
			return;
		}

		_generating = true;
		_error = null;
		_cancelNotice = null;
		_streamSegments = [];
		_generationCts = new CancellationTokenSource();
		var throttle = new ConsultationStreamThrottle(RedrawInterval);

		// Состояние генерации показывается сразу: кнопка отмены и блокировка
		// ввода появляются до первого кадра модели.
		await InvokeAsync(StateHasChanged);

		try
		{
			// Конвейер чата разрешается в момент первого вопроса: незастроенный
			// ключ модели не ломает чтение истории и остальной журнал.
			var chat = Services.GetRequiredService<ConsultationChatService>();
			var userMessage = await chat.AppendUserMessageAsync(
				ConstructionId,
				_selectedDialogueId,
				_input);

			// Вопрос зафиксирован: панель сразу показывает диалог с вопросом
			// и переходит к стримингу ответа.
			_selectedDialogueId = userMessage.DialogueId;
			_input = string.Empty;
			await RefreshAsync();
			await InvokeAsync(StateHasChanged);

			await foreach (var update in chat.StreamAssistantAnswerAsync(ConstructionId, userMessage, _generationCts.Token))
			{
				AppendUpdate(update);
				if (IsToolFrame(update))
				{
					// Статусная строка тула показывается сразу: такие кадры
					// редки, а их задержка читалась бы как зависание панели.
					await InvokeAsync(StateHasChanged);
				}
				else if (throttle.ShouldRender())
				{
					// Чанки текста перерисовываются не чаще интервала троттлинга.
					await InvokeAsync(StateHasChanged);
				}
			}

			// Финальное перечитывание: зафиксированный ответ ассистента
			// заменяет стримящееся представление.
			_streamSegments = [];
			await RefreshAsync();
		}
		catch (OperationCanceledException)
		{
			// Отмена возвращает панель в состояние ввода: вопрос остаётся в
			// диалоге, ответ ассистента не фиксируется.
			// Traceability: openspec:ui/screens#scenario-ui-cancel-generation
			_streamSegments = [];
			_cancelNotice = "Генерация отменена — вопрос остался в диалоге без ответа помощника.";
			await RefreshAsync();
		}
		catch (Exception exception)
		{
			_error = $"Ответ не получен: {exception.Message}";
		}
		finally
		{
			_generationCts.Dispose();
			_generationCts = null;
			_generating = false;
		}
	}

	/// <summary>Отменяет текущую генерацию: стрим останавливается, панель возвращается в состояние ввода.</summary>
	private void CancelGeneration() => _generationCts?.Cancel();

	/// <summary>Кадр стрима — tool-вызов или результат инструмента, а не текстовый чанк.</summary>
	private static bool IsToolFrame(ChatResponseUpdate update) =>
		update.Contents.OfType<FunctionCallContent>().Any()
		|| update.Contents.OfType<FunctionResultContent>().Any();

	/// <summary>
	/// Дополняет сегменты стрима одним обновлением модели: текст копится в
	/// текущем текстовом сегменте, tool-call фрагменты не рендерятся — вызов
	/// открывает статусную строку, результат помечает её завершённой.
	// Traceability: openspec:ui/screens#scenario-ui-streaming-with-tool-status
	/// </summary>
	private void AppendUpdate(ChatResponseUpdate update)
	{
		var call = update.Contents.OfType<FunctionCallContent>().FirstOrDefault();
		if (call is not null)
		{
			_streamSegments.Add(new StreamSegment.ToolStatus(call.CallId, call.Name, CompactArguments(call.Arguments), Completed: false));
			return;
		}

		var result = update.Contents.OfType<FunctionResultContent>().FirstOrDefault();
		if (result is not null)
		{
			CompleteToolStatus(result.CallId);
			return;
		}

		if (string.IsNullOrEmpty(update.Text) == false)
		{
			if (_streamSegments.Count > 0 && _streamSegments[^1] is StreamSegment.Text text)
			{
				text.Content.Append(update.Text);
			}
			else
			{
				_streamSegments.Add(new StreamSegment.Text(new StringBuilder(update.Text)));
			}
		}
	}

	/// <summary>Помечает статусную строку вызова завершённой по идентификатору вызова.</summary>
	private void CompleteToolStatus(string callId)
	{
		for (var index = _streamSegments.Count - 1; index >= 0; index--)
		{
			if (_streamSegments[index] is StreamSegment.ToolStatus { Completed: false } pending
				&& pending.CallId == callId)
			{
				_streamSegments[index] = pending with { Completed = true };
				return;
			}
		}
	}

	/// <summary>Аргументы tool-вызова в компактном виде для статусной строки.</summary>
	private static string CompactArguments(IDictionary<string, object?>? arguments) =>
		arguments is null || arguments.Count == 0
			? string.Empty
			: string.Join(", ", arguments.Select(pair => $"{pair.Key}={pair.Value}"));

	/// <summary>Текст статусной строки tool-вызова: идёт вызов или уже завершён.</summary>
	private static string ToolStatusText(StreamSegment.ToolStatus status) => status.Completed
		? $"вызов инструмента {status.ToolName}({status.Arguments}) — готово"
		: $"вызов инструмента {status.ToolName}({status.Arguments})…";

	/// <summary>Начинает шаг подтверждения удаления диалога.</summary>
	private void BeginDelete(long dialogueId) => _deleteConfirmDialogueId = dialogueId;

	/// <summary>Отменяет подтверждение удаления без мутаций.</summary>
	private void CancelDelete() => _deleteConfirmDialogueId = null;

	/// <summary>
	/// Удаляет диалог целиком со всеми сообщениями — hard delete без корзины;
	/// выбранный после удаления диалог сбрасывается.
	// Traceability: openspec:consultations/history#scenario-history-hard-delete-dialogue
	/// </summary>
	private async Task DeleteDialogueAsync(long dialogueId)
	{
		_deleteConfirmDialogueId = null;
		try
		{
			await Store.DeleteDialogueAsync(ConstructionId, dialogueId);
			if (_selectedDialogueId == dialogueId)
			{
				_selectedDialogueId = null;
			}

			await RefreshAsync();
		}
		catch (Exception)
		{
			_error = "Консультации недоступны: не удалось удалить диалог. Обновите экран.";
		}
	}

	/// <summary>Класс сообщения по роли автора — окраска владельца и помощника.</summary>
	private static string RoleClass(ConsultationMessageRole role) => role switch
	{
		ConsultationMessageRole.User => "user",
		ConsultationMessageRole.Assistant => "assistant",
		_ => string.Empty,
	};

	/// <summary>Роль автора сообщения словами.</summary>
	private static string RoleTitle(ConsultationMessageRole role) => role switch
	{
		ConsultationMessageRole.User => "Вы",
		ConsultationMessageRole.Assistant => "Помощник",
		_ => string.Empty,
	};

	/// <summary>Сегмент стримящегося ответа: текстовый блок или статусная строка tool-вызова.</summary>
	private abstract record StreamSegment
	{
		/// <summary>Текстовый сегмент ответа модели, накапливаемый по чанкам.</summary>
		public sealed record Text(StringBuilder Content) : StreamSegment;

		/// <summary>Статусная строка tool-вызова; сам tool-call фрагмент текстом не рендерится.</summary>
		public sealed record ToolStatus(string CallId, string ToolName, string Arguments, bool Completed) : StreamSegment;
	}
}
