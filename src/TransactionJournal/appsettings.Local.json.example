{
  // Шаблон локальных секретов журнала транзакций.
  // Скопируйте этот файл в appsettings.Local.json (без .example, рядом с exe)
  // и впишите реальные значения. Реальный файл в репозиторий не попадает —
  // он исключён из контроля версий строкой appsettings.Local.json в .gitignore.
  //
  // Файл подключается в Program.cs последним провайдером конфигурации, поэтому
  // его значения перекрывают appsettings.json, переменные окружения
  // (например, Bybit__ApiKey) и аргументы командной строки.
  // Отсутствие файла — штатная ситуация: приложение запускается, а потребитель
  // секрета сообщит о незастроенном значении в момент обращения к нему.

  // Учётные данные Bybit для кнопки «Синхронизировать сейчас».
  "Bybit": {
    "ApiKey": "",
    "ApiSecret": ""
  },

  // Канал сводки Telegram: токен бота от @BotFather и chat id получателя.
  "Telegram": {
    "BotToken": "",
    "ChatId": ""
  },

  // Общая конфигурация LLM-провайдера: провайдер, эндпоинт и ключ доступа
  // общие для всех потребителей журнала; подсекции задают только рабочие
  // модели (чат консультаций, изложение сводок подсказок). Провайдер,
  // отличный от zai, обязан указать явный BaseUrl; незастроенный ключ
  // обнаруживается потребителем лениво, в момент обращения к модели.
  "Llm": {
    "Provider": "zai",
    "BaseUrl": "https://api.z.ai/api/paas/v4",
    "ApiKey": "",
    "Chat": {
      "Model": "glm-5.3"
    },
    "Hint": {
      "Model": "glm-5.3-flash"
    }
  }
}
