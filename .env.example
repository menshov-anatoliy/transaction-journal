# Шаблон локальной конфигурации журнала транзакций.
# Скопируйте этот файл в .env и впишите реальные значения.
# Файл .env не коммитится — он исключён из контроля версий в .gitignore,
# поэтому реальные ключи остаются только на вашей машине.

# Учётные данные Bybit для кнопки «Синхронизировать»:
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Размещение: файл .env ищется от текущего рабочего каталога вверх по дереву
# каталогов — положите его в корень репозитория, рядом с исполняемым файлом
# или выше по дереву от каталога, из которого запускаете приложение.

# Приоритет: если переменная уже задана в окружении системы (например,
# BYBIT_API_KEY в пользовательских переменных Windows), значение из .env
# НЕ применяется — системные переменные всегда важнее файла.
