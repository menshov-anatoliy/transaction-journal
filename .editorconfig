# Корневые настройки оформления кода журнала сделок.
# Отступы — табы (требование .github/prompts/formatting.prompt.md).

root = true

[*]
indent_style = tab
indent_size = 4
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.cs]
csharp_style_var_when_type_is_apparent = true:suggestion

# .sln требует классические настройки Visual Studio
[*.sln]
indent_style = space
end_of_line = crlf
